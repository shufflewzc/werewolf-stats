# Production environment template for werewolf-stats.
# Copy these values into your server/1Panel environment variable settings.
# Do not commit real secrets.

APP_DIR=/app
PYTHON_BIN=python3
HOST=0.0.0.0
PORT=8000

# PostgreSQL is required for production.
DATABASE_URL=postgresql://werewolf:change-me@127.0.0.1:5432/werewolf_stats
ENABLE_POSTGRES_WRITES=1

# WeChat Mini Program login.
WECHAT_MINIPROGRAM_APPID=your-appid
WECHAT_MINIPROGRAM_SECRET=your-secret
ALLOW_WECHAT_DEV_LOGIN=0

# Public web login base URL.
WEB_LOGIN_BASE_URL=https://wolf.metauniverse-cn.xyz
COOKIE_SECURE=1

# Gunicorn runtime.
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
INSTALL_REQUIREMENTS=1

# Startup guards.
REQUIRE_DATABASE_URL=1
RUN_PRODUCTION_CONFIG_CHECK=1
APPLY_SCHEMA=1
RUN_SCHEMA_CHECK=1
RUN_SMOKE=1
RUN_LOG_CLEANUP=1

# Upload and import limits.
MAX_REQUEST_BODY_BYTES=52428800
MAX_EXCEL_UPLOAD_BYTES=10485760
MAX_EXCEL_SHEET_ROWS=2000
MAX_ZIP_UPLOAD_BYTES=52428800
MAX_ZIP_IMAGE_COUNT=300
IMPORT_BATCH_LIST_LIMIT=50
# One background worker serializes match Excel writes, avoiding competing
# full-state validations while returning the upload request immediately.
IMPORT_BACKGROUND_WORKERS=1

# Login and cache tuning.
WEB_LOGIN_TTL_SECONDS=600
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_MAX_FAILURES=8
VALIDATED_DATA_CACHE_TTL_SECONDS=5

# Logs and maintenance.
ACCESS_LOG_RETENTION_DAYS=30
AUDIT_LOG_RETENTION_DAYS=365
SLOW_REQUEST_THRESHOLD_MS=1500
# Decouple request latency from access-log persistence. Set to 0 only when
# immediate per-request log durability is more important than response time.
ACCESS_LOG_ASYNC_ENABLED=1
ACCESS_LOG_QUEUE_MAX_ENTRIES=5000
ACCESS_LOG_BATCH_SIZE=100
ACCESS_LOG_FLUSH_SECONDS=0.5
STRUCTURED_ERROR_TRACEBACK=0

# Security switches. Keep enabled in production.
SECURITY_HEADERS_ENABLED=1
CSRF_PROTECTION_ENABLED=1
# CONTENT_SECURITY_POLICY=default-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; font-src 'self' data: https://fonts.gstatic.com https://cdn.jsdelivr.net; connect-src 'self'; frame-src 'none'

# Optional AI defaults.
AI_DAILY_BRIEF_MODEL=gpt-4.1-mini

# Optional readiness write probe. Keep off unless verifying deploy.
READYZ_WRITE_CHECK=0

page {
  min-height: 100vh;
  color: #0f172a;
  background: #f4f7fb;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 28rpx 28rpx 48rpx;
  box-sizing: border-box;
}

.hero {
  padding: 34rpx 32rpx;
  border-radius: 16rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #111827 0%, #1e3a5f 58%, #be7c25 100%);
}

.eyebrow {
  font-size: 22rpx;
  line-height: 1.4;
  color: rgba(255, 255, 255, 0.72);
}

.title {
  display: block;
  margin-top: 12rpx;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.18;
}

.copy {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.55;
  color: rgba(255, 255, 255, 0.78);
}

.section {
  margin-top: 28rpx;
}

.scope-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.06);
}

.scope-main {
  flex: 1;
  min-width: 0;
}

.scope-label,
.scope-meta {
  display: block;
  font-size: 22rpx;
  color: #64748b;
}

.scope-title {
  display: block;
  margin-top: 6rpx;
  overflow: hidden;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.scope-meta {
  margin-top: 6rpx;
}

.scope-button {
  flex: 0 0 auto;
  min-width: 128rpx;
  height: 62rpx;
  padding: 0 18rpx;
  border: 1rpx solid #cbd5e1;
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 62rpx;
  color: #111827;
  background: #f8fafc;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 800;
}

.section-note {
  font-size: 22rpx;
  color: #64748b;
}

.metrics {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.metric-card,
.list-card,
.empty-card,
.error-card {
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.06);
}

.metric-card {
  padding: 22rpx;
}

.metric-label {
  display: block;
  font-size: 22rpx;
  color: #64748b;
}

.metric-value {
  display: block;
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.15;
}

.metric-copy {
  display: block;
  margin-top: 8rpx;
  font-size: 21rpx;
  line-height: 1.4;
  color: #94a3b8;
}

.list-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 112rpx;
  padding: 22rpx;
  box-sizing: border-box;
}

.rank {
  display: flex;
  flex: 0 0 56rpx;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  font-size: 24rpx;
  font-weight: 800;
  color: #ffffff;
  background: #111827;
}

.avatar,
.logo {
  flex: 0 0 72rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
  background: #e2e8f0;
}

.avatar {
  border-radius: 50%;
}

.image-placeholder {
  position: relative;
  background: #e2e8f0;
}

.image-placeholder::after {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 28rpx;
  height: 28rpx;
  border-radius: 8rpx;
  background: #cbd5e1;
  content: "";
  transform: translate(-50%, -50%);
}

.list-main {
  flex: 1;
  min-width: 0;
}

.list-title {
  display: block;
  overflow: hidden;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.list-meta {
  display: block;
  margin-top: 8rpx;
  overflow: hidden;
  font-size: 22rpx;
  color: #64748b;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.list-score {
  flex: 0 0 116rpx;
  text-align: right;
}

.score-value {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
}

.score-label {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #94a3b8;
}

.stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.empty-card,
.error-card {
  padding: 34rpx 28rpx;
  text-align: center;
}

.empty-title {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
}

.empty-copy {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #64748b;
}

.error-card {
  color: #991b1b;
  background: #fff7f7;
  border-color: #fecaca;
}

.button-row {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.quick-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 18rpx;
}

.primary-button,
.ghost-button {
  flex: 1;
  height: 76rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  line-height: 76rpx;
}

.primary-button {
  color: #ffffff;
  background: #111827;
}

.ghost-button {
  color: #111827;
  background: #ffffff;
  border: 1rpx solid #cbd5e1;
}

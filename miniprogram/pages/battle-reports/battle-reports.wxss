page { background: #eef2f1; }
.report-page { padding: 24rpx 24rpx calc(32rpx + env(safe-area-inset-bottom)); }
.scope-bar { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin: 0 4rpx 24rpx; }
.scope-name { display: block; font-size: 28rpx; font-weight: 700; color: #233633; }
.scope-season { display: block; margin-top: 6rpx; font-size: 23rpx; color: #667973; }
.scope-button { flex-shrink: 0; margin: 0; padding: 0 18rpx; font-size: 23rpx; line-height: 64rpx; background: #fff; color: #297c73; border-radius: 16rpx; }
button::after { border: 0; }
.day-card { margin-bottom: 24rpx; padding: 24rpx 22rpx 0; border-radius: 24rpx; color: #f3f6f4; background: linear-gradient(140deg, #263532, #292c2b 50%, #172f29); box-shadow: 0 10rpx 24rpx rgba(19, 42, 34, .12); overflow: hidden; }
.day-date { display: block; font-size: 32rpx; font-weight: 800; letter-spacing: 1rpx; }
.day-subtitle { display: block; font-size: 23rpx; color: #a5b4ae; margin-top: 8rpx; line-height: 1.5; }
.stage-label { display: block; font-size: 24rpx; color: #c6d9cf; margin: 22rpx 0 14rpx; }
.match-grid { display: flex; flex-wrap: wrap; margin: 0 -6rpx; }
.mvp-tile { width: 33.3333%; box-sizing: border-box; padding: 0 6rpx 22rpx; min-width: 0; }
.winner { display: block; text-align: center; font-size: 26rpx; font-weight: 700; font-style: italic; margin-bottom: 10rpx; }
.villagers { color: #9bdfd5; }
.werewolves { color: #efadb8; }
.portrait { position: relative; width: 100%; height: 270rpx; overflow: hidden; border-radius: 15rpx; background: #cad3cf; border: 2rpx solid rgba(255,255,255,.55); box-sizing: border-box; }
.player-photo { width: 100%; height: 100%; }
.mvp-tag { position: absolute; top: 7rpx; left: 7rpx; padding: 3rpx 10rpx; color: #745018; background: #f4d889; font-size: 19rpx; font-weight: 800; font-style: italic; border-radius: 4rpx; letter-spacing: 2rpx; }
.guild-logo { position: absolute; right: 7rpx; bottom: 7rpx; width: 36rpx; height: 36rpx; border-radius: 50%; background: #fff; padding: 4rpx; }
.player-name { display: block; text-align: center; font-size: 25rpx; font-weight: 600; line-height: 1.5; margin-top: 7rpx; overflow-wrap: anywhere; }
.match-number, .table-label { display: block; text-align: center; color: #aebeb7; font-size: 20rpx; line-height: 1.5; }
.day-footer { text-align: right; border-top: 1rpx solid rgba(255,255,255,.09); padding: 18rpx 0; color: #9bdfd5; font-size: 25rpx; font-weight: 600; }
.tile-hover { opacity: .75; }
.photo-fallback { width: 100%; height: 100%; position: relative; background: linear-gradient(#c9d3cd, #81958c); overflow: hidden; }
.avatar-head { position: absolute; width: 70rpx; height: 80rpx; border-radius: 50%; background: #edf1ed; left: 50%; top: 65rpx; transform: translateX(-50%); }
.avatar-body { position: absolute; width: 160rpx; height: 140rpx; border-radius: 50% 50% 0 0; background: #edf1ed; left: 50%; top: 160rpx; transform: translateX(-50%); }
.state-card { background: #fff; border-radius: 20rpx; padding: 48rpx 24rpx; text-align: center; color: #52655b; }
.state-card text { display: block; }
.state-card button { margin-top: 24rpx; font-size: 26rpx; }
.empty-copy { font-size: 25rpx; margin-top: 16rpx; line-height: 1.7; }
.list-end { text-align: center; font-size: 23rpx; color: #74887c; padding: 20rpx; }
.more-button { font-size: 26rpx; color: #297c73; background: #fff; }

<view class="page">
  <view class="hero"><text class="eyebrow">Head to Head</text><text class="title">{{typeLabel}}对比</text><text class="copy">在当前赛事与赛季内，横向查看两方的核心数据。</text></view>
  <view class="section" wx:if="{{loading}}"><view class="empty-card"><text class="empty-title">正在加载</text><text class="empty-copy">正在汇总双方数据。</text></view></view>
  <view class="section" wx:elif="{{needsCompetition}}"><view class="empty-card"><text class="empty-title">先选择赛事和赛季</text><text class="empty-copy">选择完整的赛事和赛季后才能进行同赛季对比。</text><view class="button-row"><button class="primary-button" hover-class="tap-button-hover" bindtap="goCompetitions">去选择赛事和赛季</button></view></view></view>
  <view class="section" wx:elif="{{error}}"><view class="error-card"><text>{{error}}</text><view class="button-row"><button class="ghost-button" hover-class="tap-button-hover" bindtap="loadData">重试</button></view></view></view>
  <block wx:else>
    <view class="section scope-bar"><view class="scope-main"><text class="scope-label">当前赛事</text><text class="scope-title">{{selectedScope.competition}}</text><text class="scope-meta">{{selectedScope.season}}</text></view><button class="scope-button" hover-class="tap-button-hover" bindtap="goCompetitions">切换</button></view>
    <view class="section selector-card"><picker mode="selector" range="{{candidateLabels}}" value="{{leftIndex}}" bindchange="changeLeft"><view class="selector"><text class="selector-label">左侧{{typeLabel}}</text><view class="player-name-line"><text class="selector-value">{{left.title}}</text><star-player-badge wx:if="{{type === 'player' && left.is_star_player}}" compact="{{true}}" /></view></view></picker><text class="versus">VS</text><picker mode="selector" range="{{candidateLabels}}" value="{{rightIndex}}" bindchange="changeRight"><view class="selector"><text class="selector-label">右侧{{typeLabel}}</text><view class="player-name-line"><text class="selector-value">{{right.title}}</text><star-player-badge wx:if="{{type === 'player' && right.is_star_player}}" compact="{{true}}" /></view></view></picker></view>
    <view class="section duel-card"><view class="entity tap-card" hover-class="tap-card-hover" data-side="left" bindtap="openEntity"><image wx:if="{{left.imageUrl}}" class="entity-image" src="{{left.imageUrl}}" mode="aspectFill" binderror="onImageError" data-side="left"></image><view wx:else class="entity-image image-placeholder"></view><text class="entity-name">{{left.title}}</text><text class="entity-meta">{{left.meta}}</text></view><text class="duel-vs">VS</text><view class="entity tap-card" hover-class="tap-card-hover" data-side="right" bindtap="openEntity"><image wx:if="{{right.imageUrl}}" class="entity-image" src="{{right.imageUrl}}" mode="aspectFill" binderror="onImageError" data-side="right"></image><view wx:else class="entity-image image-placeholder"></view><text class="entity-name">{{right.title}}</text><text class="entity-meta">{{right.meta}}</text></view></view>
    <view class="section"><view class="section-head"><text class="section-title">核心数据</text><text class="section-note">同一赛事范围</text></view><view class="compare-card" wx:for="{{compareRows}}" wx:key="label"><text class="compare-head">{{item.label}}</text><view class="compare-values"><view><text class="compare-value">{{item.leftValue}}</text><text class="compare-copy">{{item.leftCopy}}</text></view><text class="compare-divider">:</text><view class="compare-right"><text class="compare-value">{{item.rightValue}}</text><text class="compare-copy">{{item.rightCopy}}</text></view></view></view></view>
  </block>
</view>

.selector-card,.duel-card,.compare-card{border:1rpx solid #e2e8f0;border-radius:16rpx;background:#fff;box-shadow:0 10rpx 28rpx rgba(15,23,42,.06)}.selector-card{padding:20rpx;display:flex;align-items:center;gap:12rpx}.selector{min-width:0;padding:16rpx;border-radius:12rpx;background:#f8fafc}.selector-label,.selector-value,.entity-name,.entity-meta,.compare-copy{display:block}.selector-label{font-size:21rpx;color:#64748b}.selector-value{margin-top:6rpx;font-size:26rpx;font-weight:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.versus,.duel-vs{flex:0 0 auto;color:#b7791f;font-size:22rpx;font-weight:900}.duel-card{display:flex;align-items:center;justify-content:space-between;padding:24rpx 18rpx;gap:14rpx}.entity{width:0;flex:1;text-align:center}.entity-image{width:88rpx;height:88rpx;border-radius:50%;background:#e2e8f0}.entity-name{margin-top:12rpx;font-size:27rpx;font-weight:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.entity-meta{margin-top:6rpx;font-size:20rpx;color:#64748b;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.duel-vs{padding:0 4rpx;font-size:28rpx}.compare-card{margin-top:14rpx;padding:20rpx 22rpx}.compare-head{display:block;font-size:22rpx;color:#64748b}.compare-values{display:flex;align-items:center;justify-content:space-between;gap:14rpx;margin-top:12rpx}.compare-values>view{width:0;flex:1}.compare-right{text-align:right}.compare-value{display:block;font-size:32rpx;font-weight:900;color:#111827}.compare-copy{margin-top:4rpx;font-size:20rpx;color:#64748b;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.compare-divider{color:#d4af37;font-size:28rpx;font-weight:900}

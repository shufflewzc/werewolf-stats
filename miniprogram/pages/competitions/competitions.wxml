<view class="page">
  <view class="hero">
    <text class="eyebrow">Competitions</text>
    <text class="title">{{hero.title || "赛事入口"}}</text>
    <text class="copy">{{hero.copy || "查看地区赛事、系列赛和赛季概览。"}}</text>
  </view>

  <view wx:if="{{loading}}" class="section">
    <view class="empty-card">
      <text class="empty-title">正在加载</text>
      <text class="empty-copy">正在读取赛事列表。</text>
    </view>
  </view>

  <view wx:elif="{{error}}" class="section">
    <view class="error-card">
      <text>{{error}}</text>
      <view class="button-row">
        <button class="ghost-button" hover-class="tap-button-hover" bindtap="loadData">重试</button>
      </view>
    </view>
  </view>

  <block wx:else>
    <view class="section">
      <view class="section-head">
        <text class="section-title">城市赛事</text>
        <text class="section-note">{{competitionCount}} 个赛事</text>
      </view>
      <view class="scope-bar current-scope" wx:if="{{selectedScope && selectedScope.competition}}">
        <view class="scope-main">
          <text class="scope-label">当前已进入</text>
          <text class="scope-title">{{selectedScope.competition}}</text>
          <text class="scope-meta">{{selectedScope.region}} · {{selectedScope.seriesName || "系列赛"}} · {{selectedScope.season || "当前赛季"}}</text>
        </view>
      </view>
      <view class="city-list" wx:if="{{cityGroups.length}}">
        <view class="city-section" wx:for="{{cityGroups}}" wx:for-item="city" wx:for-index="cityIndex" wx:key="region_name">
          <view class="city-toggle tap-card {{city.expanded ? 'is-expanded' : ''}}" hover-class="tap-card-hover" data-city-index="{{cityIndex}}" bindtap="toggleCity" aria-label="{{city.region_name}}，{{city.competition_count}} 个赛事" aria-expanded="{{city.expanded}}">
            <view class="city-main">
              <text class="city-name">{{city.region_name}}</text>
              <text class="city-meta">{{city.competition_count}} 个赛事 · 最近 {{city.latest_played_on || "待更新"}}</text>
            </view>
            <text class="city-action">{{city.expanded ? "收起" : "展开"}}</text>
            <text class="city-chevron {{city.expanded ? 'is-expanded' : ''}}">›</text>
          </view>

          <view class="city-competitions" wx:if="{{city.expanded}}">
            <view class="competition-card {{item.isSelected ? 'is-selected' : ''}}" wx:for="{{city.cards}}" wx:for-item="item" wx:for-index="cardIndex" wx:key="competition_name">
              <text class="card-kicker">{{item.series_name || "系列赛"}}</text>
              <text class="card-title">{{item.competition_name}}</text>
              <text class="card-copy">最近 {{item.latest_played_on || "待更新"}}</text>
              <picker mode="selector" range="{{item.seasons}}" value="{{item.selectedSeasonIndex}}" data-city-index="{{cityIndex}}" data-card-index="{{cardIndex}}" bindchange="chooseSeason">
                <view class="season-picker" hover-class="tap-chip-hover">
                  <view>
                    <text class="season-label">赛季</text>
                    <text class="season-value">{{item.selectedSeason || "待录入"}}</text>
                  </view>
                  <text class="season-action">{{item.hasMultipleSeasons ? "切换" : "当前"}}</text>
                </view>
              </picker>
              <button class="enter-label" hover-class="tap-button-hover" data-city-index="{{cityIndex}}" data-card-index="{{cardIndex}}" bindtap="chooseCompetition">{{item.enterText}}</button>
            </view>
          </view>
        </view>
      </view>
      <view class="empty-card" wx:else>
        <text class="empty-title">暂无城市赛事</text>
        <text class="empty-copy">网站后台创建城市和赛事后，小程序会自动显示。</text>
      </view>
    </view>
  </block>
</view>

<view class="page">
  <view class="hero">
    <text class="eyebrow">Competitions</text>
    <text class="title">{{hero.title || "赛事入口"}}</text>
    <text class="copy">{{hero.copy || "查看地区赛事、系列赛和赛季概览。"}}</text>
  </view>

  <view wx:if="{{loading}}" class="section">
    <view class="empty-card">
      <text class="empty-title">正在加载</text>
      <text class="empty-copy">正在读取赛事列表。</text>
    </view>
  </view>

  <view wx:elif="{{error}}" class="section">
    <view class="error-card">
      <text>{{error}}</text>
    </view>
  </view>

  <block wx:else>
    <view class="section" wx:if="{{metrics.length}}">
      <view class="metrics">
        <view class="metric-card" wx:for="{{metrics}}" wx:key="label">
          <text class="metric-label">{{item.label}}</text>
          <text class="metric-value">{{item.value}}</text>
          <text class="metric-copy">{{item.copy}}</text>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-head">
        <text class="section-title">赛事站点</text>
        <text class="section-note">{{cards.length}} 个</text>
      </view>
      <view class="scope-bar current-scope" wx:if="{{selectedScope && selectedScope.competition}}">
        <view class="scope-main">
          <text class="scope-label">当前已进入</text>
          <text class="scope-title">{{selectedScope.competition}}</text>
          <text class="scope-meta">{{selectedScope.region}} · {{selectedScope.seriesName || "系列赛"}} · {{selectedScope.season || "当前赛季"}}</text>
        </view>
      </view>
      <view class="stack" wx:if="{{cards.length}}">
        <view class="competition-card" wx:for="{{cards}}" wx:key="competition_name">
          <text class="card-kicker">{{item.region_name || "赛区"}} · {{item.series_name || "系列赛"}}</text>
          <text class="card-title">{{item.competition_name}}</text>
          <text class="card-copy">最近 {{item.latest_played_on || "待更新"}}</text>
          <picker mode="selector" range="{{item.seasons}}" value="{{item.selectedSeasonIndex}}" data-index="{{index}}" bindchange="chooseSeason">
            <view class="season-picker">
              <view>
                <text class="season-label">赛季</text>
                <text class="season-value">{{item.selectedSeason || "待录入"}}</text>
              </view>
              <text class="season-action">{{item.hasMultipleSeasons ? "切换" : "当前"}}</text>
            </view>
          </picker>
          <view class="card-stats">
            <view>
              <text class="stat-value">{{item.team_count || 0}}</text>
              <text class="stat-label">门派</text>
            </view>
            <view>
              <text class="stat-value">{{item.player_count || 0}}</text>
              <text class="stat-label">选手</text>
            </view>
            <view>
              <text class="stat-value">{{item.match_count || 0}}</text>
              <text class="stat-label">对局</text>
            </view>
          </view>
          <button class="enter-label" data-index="{{index}}" bindtap="chooseCompetition">{{item.enterText}}</button>
        </view>
      </view>
      <view class="empty-card" wx:else>
        <text class="empty-title">暂无赛事</text>
        <text class="empty-copy">网站后台录入赛事后，小程序会自动显示。</text>
      </view>
    </view>
  </block>
</view>

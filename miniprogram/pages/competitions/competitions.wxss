.competition-card {
  padding: 26rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.06);
}

.current-scope {
  margin-bottom: 16rpx;
}

.card-kicker,
.card-copy,
.stat-label {
  display: block;
  font-size: 22rpx;
  color: #64748b;
}

.card-title {
  display: block;
  margin-top: 10rpx;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.25;
}

.card-copy {
  margin-top: 10rpx;
}

.season-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 18rpx;
  padding: 18rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  background: #f8fafc;
}

.season-label,
.season-value,
.season-action {
  display: block;
}

.season-label {
  font-size: 22rpx;
  color: #64748b;
}

.season-value {
  margin-top: 6rpx;
  font-size: 28rpx;
  font-weight: 800;
  color: #0f172a;
}

.season-action {
  flex: 0 0 auto;
  font-size: 24rpx;
  font-weight: 700;
  color: #2563eb;
}

.stat-value {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
}

.enter-label {
  display: block;
  margin-top: 20rpx;
  padding: 0;
  height: 64rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 64rpx;
  text-align: center;
  color: #ffffff;
  background: #111827;
}

<view class="page">
  <view class="hero">
    <text class="eyebrow">{{generatedAt || "赛事数据"}}</text>
    <text class="title">{{scopeLabel}}</text>
    <text class="copy" wx:if="{{choosing}}">必须先进入一个赛事，之后才能查看该赛事内的门派、选手和比赛详情。</text>
    <text class="copy" wx:else>{{hero.featured_label || "当前赛事详情"}}</text>
    <view class="button-row" wx:if="{{!choosing}}">
      <button class="primary-button" hover-class="tap-button-hover" bindtap="goTeams">门派</button>
      <button class="ghost-button" hover-class="tap-button-hover" bindtap="goPlayers">选手榜</button>
      <button class="ghost-button" hover-class="tap-button-hover" bindtap="goPredictions">胜率预测</button>
    </view>
  </view>

  <view wx:if="{{loading}}" class="section">
    <view class="empty-card">
      <text class="empty-title">正在加载</text>
      <text class="empty-copy">正在读取赛事数据。</text>
    </view>
  </view>

  <view wx:elif="{{error}}" class="section">
    <view class="error-card">
      <text>{{error}}</text>
      <view class="button-row">
        <button class="ghost-button" hover-class="tap-button-hover" bindtap="loadData">重试</button>
      </view>
    </view>
  </view>

  <block wx:else>
    <view class="section" wx:if="{{choosing}}">
      <view class="section-head">
        <text class="section-title">先选择赛事</text>
        <text class="section-note">{{competitions.length}} 个</text>
      </view>
      <view class="stack" wx:if="{{competitions.length}}">
        <view class="competition-choice" wx:for="{{competitions}}" wx:key="competition_name">
          <view class="list-main">
            <text class="list-title">{{item.competition_name}}</text>
            <text class="list-meta">{{item.region_name}} · {{item.series_name}}</text>
            <picker mode="selector" range="{{item.seasons}}" value="{{item.selectedSeasonIndex}}" data-index="{{index}}" bindchange="chooseSeason">
              <view class="season-picker compact-season-picker" hover-class="tap-chip-hover">
                <text class="season-value">{{item.selectedSeason || "赛季待录入"}}</text>
                <text class="season-action">{{item.hasMultipleSeasons ? "切换" : "当前"}}</text>
              </view>
            </picker>
          </view>
          <button class="choice-enter" hover-class="tap-button-hover" data-index="{{index}}" bindtap="chooseCompetition">进入</button>
        </view>
      </view>
      <view class="empty-card" wx:else>
        <text class="empty-title">暂无赛事</text>
        <text class="empty-copy">网站后台录入赛事后，小程序会显示入口。</text>
      </view>
    </view>

    <block wx:if="{{!choosing}}">
      <view class="section selected-bar">
        <view>
          <text class="selected-label">当前赛事</text>
          <text class="selected-title">{{selectedScope.competition}}</text>
          <text class="selected-meta">{{selectedScope.region}} · {{selectedScope.seriesName || "系列赛"}} · {{selectedScope.season || "当前赛季"}}</text>
        </view>
        <button class="change-button" hover-class="tap-button-hover" bindtap="changeCompetition">切换</button>
      </view>

    <view class="section">
      <view class="season-search-card">
        <view class="season-search-row">
          <input class="season-search-input" value="{{searchKeyword}}" placeholder="搜索选手 / 战队 / 门派（至少 2 字）" confirm-type="search" bindinput="updateSearchKeyword" bindconfirm="searchSeason" />
          <button class="season-search-button" hover-class="tap-button-hover" loading="{{searchLoading}}" bindtap="searchSeason">搜索</button>
          <button class="season-clear-button" hover-class="tap-button-hover" wx:if="{{searchKeyword}}" bindtap="clearSearch">清空</button>
        </view>
        <view class="search-results" wx:if="{{searchResults.length}}">
          <view class="search-result tap-card" hover-class="tap-card-hover" wx:for="{{searchResults}}" wx:key="key" data-index="{{index}}" bindtap="openSearchResult">
            <text class="search-type">{{item.typeLabel}}</text>
            <view class="list-main">
              <text class="list-title">{{item.title}}</text>
              <text class="list-meta">{{item.subtitle}}</text>
            </view>
            <text class="tap-cue">›</text>
          </view>
        </view>
        <view class="empty-inline" wx:if="{{searchSearched && !searchLoading && !searchResults.length}}">
          <text>{{searchKeyword.length < 2 ? "请输入至少 2 个字。" : "当前赛事没有匹配结果。"}}</text>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="workbench-card">
        <view class="workbench-head">
          <view>
            <text class="workbench-kicker">我的赛事工作台</text>
            <text class="workbench-title">{{myStatusLabel}}</text>
          </view>
          <button class="scope-button" hover-class="tap-button-hover" bindtap="goMine">我的</button>
        </view>

        <view class="my-player-card tap-card" hover-class="tap-card-hover" wx:if="{{myPlayer}}" bindtap="openMyPlayerDetail">
          <view class="list-main">
            <text class="list-title">{{myPlayer.display_name}}</text>
            <text class="list-meta">{{myPlayer.team_name || "未绑定门派"}} · 当前积分 {{myPlayer.points_total || "--"}} · 出场 {{myPlayer.games_played || "--"}} 局</text>
          </view>
          <button class="scope-button" hover-class="tap-button-hover" bindtap="openMyPlayerDetail">详情</button>
        </view>

        <view class="empty-inline" wx:if="{{!myPlayer}}">
          <text>{{myEmptyText}}</text>
        </view>

        <view class="quick-actions">
          <button class="primary-button" hover-class="tap-button-hover" wx:if="{{myPlayer}}" bindtap="openMyPlayerDetail">我的选手页</button>
          <button class="primary-button" hover-class="tap-button-hover" wx:else bindtap="goBindPlayer">{{myPrimaryActionText}}</button>
          <button class="ghost-button" hover-class="tap-button-hover" bindtap="openLatestDayPrediction">比赛日预测</button>
        </view>
      </view>
    </view>

    <view class="section" wx:if="{{latestDay}}">
      <view class="day-focus-card tap-card" hover-class="tap-card-hover" data-played-on="{{latestDay.played_on}}" bindtap="openDayDetail">
        <view class="list-main">
          <text class="selected-label">比赛日中心 · 最近更新</text>
          <text class="day-focus-title">{{latestDay.played_on}}</text>
          <text class="list-meta">{{latestDay.competition_names[0] || selectedScope.competition}} · {{latestDay.match_count}} 场 · 点开看当天赛程和日榜</text>
        </view>
        <view class="match-day-actions">
          <button class="day-action" hover-class="tap-button-hover" data-played-on="{{latestDay.played_on}}" catchtap="openLatestDayPrediction">预测</button>
          <text class="day-pill">详情</text>
        </view>
        <text class="tap-cue">›</text>
      </view>
    </view>

    <view class="section" wx:if="{{followedPlayers.length}}">
      <view class="section-head">
        <text class="section-title">我关注的选手</text>
        <text class="section-note">{{followedPlayers.length}} 人</text>
      </view>
      <view class="stack">
        <view class="list-card tap-card" hover-class="tap-card-hover" wx:for="{{followedPlayers}}" wx:key="player_id" data-player-id="{{item.player_id}}" bindtap="openFollowedPlayer">
          <view class="list-main">
            <text class="list-title">{{item.display_name}}</text>
            <text class="list-meta">{{item.team_name}} · 排名 #{{item.rank || "--"}} · 积分 {{item.points_total || "--"}}</text>
            <text class="list-meta">{{item.recent_label || "正在同步最新战绩"}}</text>
          </view>
          <text class="tap-cue">›</text>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="metrics">
        <view class="metric-card" wx:for="{{metrics}}" wx:key="label">
          <text class="metric-label">{{item.label}}</text>
          <text class="metric-value">{{item.value}}</text>
          <text class="metric-copy">{{item.copy}}</text>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-head">
        <text class="section-title">排行榜</text>
        <text class="section-note">{{leaderboardRows.length}} 名</text>
      </view>
      <scroll-view class="leaderboard-stage-scroll" scroll-x enhanced show-scrollbar="{{false}}" wx:if="{{leaderboardStages.length > 1}}">
        <view class="leaderboard-stages">
          <view
            class="leaderboard-stage {{activeLeaderboardStage === item.key ? 'is-active' : ''}}"
            wx:for="{{leaderboardStages}}"
            wx:key="key"
            data-stage="{{item.key}}"
            hover-class="tap-chip-hover"
            bindtap="changeLeaderboardStage"
          >{{item.label}}</view>
        </view>
      </scroll-view>
      <view class="leaderboard-tabs">
        <view
          class="leaderboard-tab {{activeLeaderboard === item.key ? 'is-active' : ''}}"
          wx:for="{{leaderboardTabs}}"
          wx:key="key"
          data-key="{{item.key}}"
          hover-class="tap-chip-hover"
          bindtap="changeLeaderboard"
        >
          <text class="leaderboard-tab-text">{{item.label}}</text>
        </view>
      </view>
      <view class="stack" wx:if="{{leaderboardRows.length}}">
        <view class="list-card tap-card" hover-class="tap-card-hover" wx:for="{{leaderboardRows}}" wx:key="key" data-index="{{index}}" bindtap="openLeaderboardRow">
          <text class="rank">{{item.rank}}</text>
          <view class="list-main">
            <text class="list-title">{{item.title}}</text>
            <text class="list-meta">{{item.meta}}</text>
          </view>
          <view class="list-score">
            <text class="score-value">{{item.value}}</text>
            <text class="score-label">{{item.valueLabel}}</text>
          </view>
          <text class="tap-cue">›</text>
        </view>
      </view>
      <view class="empty-card" wx:else>
        <text class="empty-title">暂无榜单数据</text>
      </view>
    </view>

    <view class="section" wx:if="{{matchDays.length}}">
      <view class="section-head">
        <text class="section-title">最近比赛日</text>
      </view>
      <view class="stack">
        <view class="list-card day-card tap-card" hover-class="tap-card-hover" wx:for="{{matchDays}}" wx:key="played_on" data-played-on="{{item.played_on}}" bindtap="openDayDetail">
          <view class="list-main">
            <text class="list-title">{{item.played_on}}</text>
            <text class="list-meta">{{item.competition_names[0] || "赛事"}} · {{item.match_count}} 场</text>
          </view>
          <text class="day-pill">Match Day</text>
          <text class="tap-cue">›</text>
        </view>
      </view>
    </view>
    </block>
  </block>
</view>

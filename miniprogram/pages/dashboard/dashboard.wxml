<view class="page">
  <view class="hero">
    <text class="eyebrow">{{generatedAt || "赛事数据"}}</text>
    <text class="title">{{scopeLabel}}</text>
    <text class="copy" wx:if="{{choosing}}">必须先进入一个赛事，之后才能查看该赛事内的战队、选手和比赛详情。</text>
    <text class="copy" wx:else>{{hero.featured_label || "当前赛事详情"}}</text>
    <view class="button-row" wx:if="{{!choosing}}">
      <button class="primary-button" bindtap="goTeams">门派</button>
      <button class="ghost-button" bindtap="goPlayers">选手榜</button>
      <button class="ghost-button" bindtap="goPredictions">胜率预测</button>
    </view>
  </view>

  <view wx:if="{{loading}}" class="section">
    <view class="empty-card">
      <text class="empty-title">正在加载</text>
      <text class="empty-copy">正在读取赛事数据。</text>
    </view>
  </view>

  <view wx:elif="{{error}}" class="section">
    <view class="error-card">
      <text>{{error}}</text>
    </view>
  </view>

  <block wx:else>
    <view class="section" wx:if="{{choosing}}">
      <view class="section-head">
        <text class="section-title">先选择赛事</text>
        <text class="section-note">{{competitions.length}} 个</text>
      </view>
      <view class="stack" wx:if="{{competitions.length}}">
        <view class="competition-choice" wx:for="{{competitions}}" wx:key="competition_name" data-index="{{index}}" bindtap="chooseCompetition">
          <view class="list-main">
            <text class="list-title">{{item.competition_name}}</text>
            <text class="list-meta">{{item.region_name}} · {{item.series_name}} · {{item.seasons[0] || "赛季待录入"}}</text>
          </view>
          <view class="choice-stats">
            <text>{{item.match_count || 0}} 场</text>
          </view>
        </view>
      </view>
      <view class="empty-card" wx:else>
        <text class="empty-title">暂无赛事</text>
        <text class="empty-copy">网站后台录入赛事后，小程序会显示入口。</text>
      </view>
    </view>

    <block wx:if="{{!choosing}}">
      <view class="section selected-bar">
        <view>
          <text class="selected-label">当前赛事</text>
          <text class="selected-title">{{selectedScope.competition}}</text>
        </view>
        <button class="change-button" bindtap="changeCompetition">切换</button>
      </view>

    <view class="section">
      <view class="metrics">
        <view class="metric-card" wx:for="{{metrics}}" wx:key="label">
          <text class="metric-label">{{item.label}}</text>
          <text class="metric-value">{{item.value}}</text>
          <text class="metric-copy">{{item.copy}}</text>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-head">
        <text class="section-title">战队积分</text>
        <text class="section-note">Top 5</text>
      </view>
      <view class="stack" wx:if="{{topTeams.length}}">
        <view class="list-card" wx:for="{{topTeams}}" wx:key="team_id">
          <text class="rank">{{item.rank}}</text>
          <image class="logo" src="{{item.logoUrl}}" mode="aspectFill"></image>
          <view class="list-main">
            <text class="list-title">{{item.short_name || item.name}}</text>
            <text class="list-meta">胜率 {{item.win_rate}} · 出赛 {{item.matches_represented}} 场</text>
          </view>
          <view class="list-score">
            <text class="score-value">{{item.points_total}}</text>
            <text class="score-label">积分</text>
          </view>
        </view>
      </view>
      <view class="empty-card" wx:else>
        <text class="empty-title">暂无战队数据</text>
      </view>
    </view>

    <view class="section">
      <view class="section-head">
        <text class="section-title">选手积分</text>
        <text class="section-note">Top 5</text>
      </view>
      <view class="stack" wx:if="{{topPlayers.length}}">
        <view class="list-card" wx:for="{{topPlayers}}" wx:key="player_id" data-player-id="{{item.player_id}}" bindtap="openPlayerDetail">
          <text class="rank">{{item.rank}}</text>
          <image class="avatar" src="{{item.photoUrl}}" mode="aspectFill"></image>
          <view class="list-main">
            <text class="list-title">{{item.display_name}}</text>
            <text class="list-meta">{{item.team_name}} · 出场 {{item.games_played}} 局</text>
          </view>
          <view class="list-score">
            <text class="score-value">{{item.points_total}}</text>
            <text class="score-label">积分</text>
          </view>
        </view>
      </view>
      <view class="empty-card" wx:else>
        <text class="empty-title">暂无选手数据</text>
      </view>
    </view>

    <view class="section" wx:if="{{matchDays.length}}">
      <view class="section-head">
        <text class="section-title">最近比赛日</text>
      </view>
      <view class="stack">
        <view class="list-card day-card" wx:for="{{matchDays}}" wx:key="played_on">
          <view class="list-main">
            <text class="list-title">{{item.played_on}}</text>
            <text class="list-meta">{{item.competition_names[0] || "赛事"}} · {{item.match_count}} 场</text>
          </view>
          <text class="day-pill">Match Day</text>
        </view>
      </view>
    </view>
    </block>
  </block>
</view>

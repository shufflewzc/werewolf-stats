.day-card {
  min-height: 96rpx;
}

.day-pill {
  flex: 0 0 auto;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #92400e;
  background: #fef3c7;
}

.competition-choice,
.selected-bar {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.06);
}

.choice-stats {
  flex: 0 0 auto;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #0f172a;
  background: #e2e8f0;
}

.selected-bar {
  justify-content: space-between;
}

.selected-label,
.selected-title {
  display: block;
}

.selected-label {
  font-size: 22rpx;
  color: #64748b;
}

.selected-title {
  margin-top: 6rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.change-button {
  flex: 0 0 132rpx;
  width: 132rpx;
  height: 64rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 64rpx;
  color: #111827;
  background: #f8fafc;
  border: 1rpx solid #cbd5e1;
}

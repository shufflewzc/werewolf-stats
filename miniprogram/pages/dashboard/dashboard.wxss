.day-card {
  min-height: 96rpx;
}

.day-pill {
  flex: 0 0 auto;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #92400e;
  background: #fef3c7;
}

.competition-choice,
.selected-bar {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.06);
}

.competition-choice {
  align-items: stretch;
}

.compact-season-picker {
  margin-top: 12rpx;
  padding: 14rpx 16rpx;
}

.season-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  background: #f8fafc;
}

.season-value,
.season-action {
  display: block;
}

.season-value {
  overflow: hidden;
  font-size: 24rpx;
  font-weight: 800;
  color: #0f172a;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.season-action {
  flex: 0 0 auto;
  font-size: 22rpx;
  font-weight: 700;
  color: #2563eb;
}

.choice-stats {
  flex: 0 0 auto;
  align-self: center;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #0f172a;
  background: #e2e8f0;
}

.choice-enter {
  flex: 0 0 96rpx;
  align-self: center;
  width: 96rpx;
  height: 58rpx;
  padding: 0;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 58rpx;
  color: #ffffff;
  background: #111827;
}

.selected-bar {
  justify-content: space-between;
}

.selected-label,
.selected-title,
.selected-meta {
  display: block;
}

.selected-label {
  font-size: 22rpx;
  color: #64748b;
}

.selected-title {
  margin-top: 6rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.selected-meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #64748b;
}

.change-button {
  flex: 0 0 132rpx;
  width: 132rpx;
  height: 64rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 64rpx;
  color: #111827;
  background: #f8fafc;
  border: 1rpx solid #cbd5e1;
}

.season-search-card {
  padding: 22rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.06);
}

.season-search-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.season-search-input {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  padding: 0 18rpx;
  border: 1rpx solid #cbd5e1;
  border-radius: 12rpx;
  box-sizing: border-box;
  font-size: 25rpx;
  background: #f8fafc;
}

.season-search-button,
.season-clear-button {
  flex: 0 0 104rpx;
  width: 104rpx;
  height: 68rpx;
  margin: 0;
  padding: 0;
  border-radius: 12rpx;
  box-sizing: border-box;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 68rpx;
  text-align: center;
}

.season-search-button::after,
.season-clear-button::after {
  border: 0;
}

.season-search-button {
  color: #ffffff;
  background: #111827;
}

.season-clear-button {
  color: #334155;
  background: #e2e8f0;
}

.search-results {
  margin-top: 18rpx;
}

.search-result {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 88rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid #e2e8f0;
}

.search-type {
  flex: 0 0 76rpx;
  height: 42rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 42rpx;
  text-align: center;
  color: #2563eb;
  background: #dbeafe;
}

.leaderboard-tabs {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10rpx;
  margin-bottom: 18rpx;
  padding: 8rpx;
  border-radius: 14rpx;
  background: #e2e8f0;
}

.leaderboard-tab {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 62rpx;
  padding: 0 6rpx;
  border-radius: 10rpx;
  box-sizing: border-box;
  color: #475569;
  background: transparent;
}

.leaderboard-tab-text {
  display: block;
  width: 100%;
  overflow: hidden;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.2;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.leaderboard-tab.is-active {
  color: #ffffff;
  background: #111827;
}

.workbench-card,
.day-focus-card {
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.06);
}

.workbench-card {
  padding: 24rpx;
}

.workbench-head,
.my-player-card,
.day-focus-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.workbench-head {
  justify-content: space-between;
}

.workbench-kicker,
.workbench-title {
  display: block;
}

.workbench-kicker {
  font-size: 22rpx;
  color: #64748b;
}

.workbench-title {
  margin-top: 6rpx;
  font-size: 32rpx;
  font-weight: 800;
}

.my-player-card {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  background: #f8fafc;
}

.empty-inline {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: #64748b;
  background: #f8fafc;
}

.day-focus-card {
  min-height: 112rpx;
  padding: 24rpx;
}

.day-focus-title {
  display: block;
  margin-top: 6rpx;
  font-size: 34rpx;
  font-weight: 800;
}

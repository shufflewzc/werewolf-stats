.day-card {
  min-height: 96rpx;
}

.regular-tier-tabs {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin: 14rpx 0 18rpx;
  padding: 8rpx;
  border-radius: 14rpx;
  background: #e2e8f0;
}

.regular-tier-tab {
  padding: 16rpx 12rpx;
  border-radius: 10rpx;
  font-size: 24rpx;
  font-weight: 800;
  text-align: center;
  color: #64748b;
}

.regular-tier-tab.is-active {
  color: #ffffff;
  background: #111827;
  box-shadow: 0 8rpx 18rpx rgba(15, 23, 42, 0.18);
}

.group-badge,
.progress-badge,
.row-badge {
  flex: 0 0 auto;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  font-weight: 900;
  line-height: 1.2;
}

.group-badge.is-s {
  color: #92400e;
  background: #fef3c7;
  border: 1rpx solid #fbbf24;
}

.group-badge.is-f {
  color: #1e40af;
  background: #dbeafe;
  border: 1rpx solid #93c5fd;
}

.progress-badge.is-direct {
  color: #7c2d12;
  background: #ffedd5;
}

.progress-badge.is-promoted {
  color: #166534;
  background: #dcfce7;
}

.progress-badge.is-eliminated {
  color: #991b1b;
  background: #fee2e2;
}

.row-badge.is-gold {
  color: #92400e;
  background: #fef3c7;
  border: 1rpx solid #fbbf24;
}

.row-badge.is-blue {
  color: #1e40af;
  background: #dbeafe;
  border: 1rpx solid #93c5fd;
}

.row-badge.is-green {
  color: #166534;
  background: #dcfce7;
}

.row-badge.is-red {
  color: #991b1b;
  background: #fee2e2;
}

.row-badge.is-orange {
  color: #7c2d12;
  background: #ffedd5;
}

.row-badge.is-gray {
  color: #475569;
  background: #e2e8f0;
}

.day-pill {
  flex: 0 0 auto;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #92400e;
  background: #fef3c7;
}

.competition-choice,
.selected-bar {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.06);
}

.competition-choice {
  align-items: stretch;
}

.compact-season-picker {
  margin-top: 12rpx;
  padding: 14rpx 16rpx;
}

.season-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  background: #f8fafc;
}

.season-value,
.season-action {
  display: block;
}

.season-value {
  overflow: hidden;
  font-size: 24rpx;
  font-weight: 800;
  color: #0f172a;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.season-action {
  flex: 0 0 auto;
  font-size: 22rpx;
  font-weight: 700;
  color: #2563eb;
}

.choice-enter {
  flex: 0 0 96rpx;
  align-self: center;
  width: 96rpx;
  height: 58rpx;
  padding: 0;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 58rpx;
  color: #ffffff;
  background: #111827;
}

.choice-enter[disabled] {
  color: #64748b;
  background: #e2e8f0;
}

.selected-bar {
  justify-content: space-between;
}

.selected-label,
.selected-title,
.selected-meta {
  display: block;
}

.selected-label {
  font-size: 22rpx;
  color: #64748b;
}

.selected-title {
  margin-top: 6rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.selected-meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #64748b;
}

.change-button {
  flex: 0 0 156rpx;
  width: 156rpx;
  height: 64rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 64rpx;
  color: #111827;
  background: #f8fafc;
  border: 1rpx solid #cbd5e1;
  white-space: nowrap;
}

.season-search-card {
  padding: 22rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.06);
}

.season-search-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.season-search-input {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  padding: 0 18rpx;
  border: 1rpx solid #cbd5e1;
  border-radius: 12rpx;
  box-sizing: border-box;
  font-size: 25rpx;
  background: #f8fafc;
}

.season-search-button,
.season-clear-button {
  flex: 0 0 104rpx;
  width: 104rpx;
  height: 68rpx;
  margin: 0;
  padding: 0;
  border-radius: 12rpx;
  box-sizing: border-box;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 68rpx;
  text-align: center;
}

.season-search-button::after,
.season-clear-button::after {
  border: 0;
}

.season-search-button {
  color: #ffffff;
  background: #111827;
}

.season-clear-button {
  color: #334155;
  background: #e2e8f0;
}

.search-results {
  margin-top: 18rpx;
}

.search-result {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 88rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid #e2e8f0;
}

.search-type {
  flex: 0 0 76rpx;
  height: 42rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 42rpx;
  text-align: center;
  color: #2563eb;
  background: #dbeafe;
}

.leaderboard-tabs {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10rpx;
  margin-bottom: 18rpx;
  padding: 8rpx;
  border-radius: 14rpx;
  background: #e2e8f0;
}

.leaderboard-stage-scroll {
  width: 100%;
  margin-bottom: 16rpx;
  white-space: nowrap;
}

.leaderboard-stages {
  display: inline-flex;
  gap: 12rpx;
  min-width: 100%;
}

.leaderboard-stage {
  flex: none;
  height: 52rpx;
  padding: 0 24rpx;
  border: 1rpx solid #cbd5e1;
  border-radius: 999rpx;
  color: #475569;
  background: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 52rpx;
}

.leaderboard-stage.is-active {
  border-color: #2563eb;
  color: #ffffff;
  background: #2563eb;
}

.leaderboard-tab {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 62rpx;
  padding: 0 6rpx;
  border-radius: 10rpx;
  box-sizing: border-box;
  color: #475569;
  background: transparent;
}

.leaderboard-tab-text {
  display: block;
  width: 100%;
  overflow: hidden;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.2;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.leaderboard-tab.is-active {
  color: #ffffff;
  background: #111827;
}

.player-metric-tabs {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8rpx;
  margin-bottom: 16rpx;
  padding: 6rpx;
  border: 1rpx solid #d8e0eb;
  border-radius: 12rpx;
  background: #edf1f6;
}

.player-metric-tab {
  height: 56rpx;
  border-radius: 8rpx;
  color: #526176;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 56rpx;
  text-align: center;
}

.player-metric-tab.is-active {
  color: #1f5fd1;
  background: #ffffff;
  box-shadow: 0 3rpx 10rpx rgba(15, 23, 42, 0.08);
}

.workbench-card {
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.06);
}

.workbench-card {
  padding: 24rpx;
}

.workbench-head,
.my-player-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.workbench-head {
  justify-content: space-between;
}

.workbench-kicker,
.workbench-title {
  display: block;
}

.workbench-kicker {
  font-size: 22rpx;
  color: #64748b;
}

.workbench-title {
  margin-top: 6rpx;
  font-size: 32rpx;
  font-weight: 800;
}

.my-player-card {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  background: #f8fafc;
}

.empty-inline {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: #64748b;
  background: #f8fafc;
}

/* Homepage visual polish: restrained, professional data presentation. */
.page {
  color: #0b1730;
  padding: 24rpx 24rpx 48rpx;
  background: #f4f6fa;
}

.hero {
  padding: 32rpx 30rpx;
  overflow: hidden;
  border: 1rpx solid rgba(116, 149, 194, 0.2);
  border-radius: 18rpx;
  background: #0b1730;
  box-shadow: 0 12rpx 28rpx rgba(11, 23, 48, 0.14);
}


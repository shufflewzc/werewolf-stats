<view class="page">
  <view class="hero">
    <text class="eyebrow">{{selectedScope.competition || "比赛日"}}</text>
    <text class="title">{{hero.title || (playedOn + " 比赛日")}}</text>
    <text class="copy">{{hero.copy || "查看当天赛程、选手日榜和比赛日总分预测。"}}</text>
    <view class="button-row">
      <button class="primary-button" hover-class="tap-button-hover" bindtap="goPredictions">当日预测</button>
      <button class="ghost-button" hover-class="tap-button-hover" bindtap="goCompetitions">赛事入口</button>
    </view>
  </view>

  <view wx:if="{{loading}}" class="section">
    <view class="empty-card">
      <text class="empty-title">正在加载</text>
      <text class="empty-copy">正在读取比赛日数据。</text>
    </view>
  </view>

  <view wx:elif="{{needsCompetition}}" class="section">
    <view class="empty-card">
      <text class="empty-title">先选择赛事和赛季</text>
      <text class="empty-copy">选择完整的赛事和赛季后，才能查看该赛季的比赛日详情和预测榜。</text>
      <view class="button-row">
        <button class="primary-button" hover-class="tap-button-hover" bindtap="goCompetitions">去选择赛事和赛季</button>
      </view>
    </view>
  </view>

  <view wx:elif="{{error}}" class="section">
    <view class="error-card">
      <text>{{error}}</text>
      <view class="button-row">
        <button class="ghost-button" hover-class="tap-button-hover" bindtap="loadData">重试</button>
      </view>
    </view>
  </view>

  <block wx:else>
    <view class="section">
      <view class="metrics">
        <view class="metric-card" wx:for="{{metrics}}" wx:key="label">
          <text class="metric-label">{{item.label}}</text>
          <text class="metric-value">{{item.value}}</text>
          <text class="metric-copy">{{item.copy}}</text>
        </view>
      </view>
    </view>

    <view class="section" wx:if="{{predictions.length}}">
      <view class="section-head">
        <text class="section-title">预测总分榜</text>
        <text class="section-note">{{predictionVisibleCount}} / {{predictionTotalCount}} 人</text>
      </view>
      <view class="stack">
        <view class="list-card tap-card" hover-class="tap-card-hover" wx:for="{{visiblePredictions}}" wx:key="player_id" data-player-id="{{item.player_id}}" bindtap="openPlayer">
          <text class="rank">{{index + 1}}</text>
          <view class="list-main">
            <view class="player-name-line">
              <text class="list-title">{{item.player_name}}</text>
              <star-player-badge wx:if="{{item.is_star_player}}" compact="{{true}}" />
            </view>
            <text class="list-meta">{{item.team_name || "未绑定战队"}} · {{item.match_count}} 场 · 场均 {{item.average_expected_points}}</text>
          </view>
          <view class="list-score">
            <text class="score-value">{{item.expected_total || item.expected_points}}</text>
            <text class="score-label">预计总分</text>
          </view>
          <text class="tap-cue">›</text>
        </view>
      </view>
      <view class="button-row" wx:if="{{predictionHasMore}}">
        <button class="ghost-button" hover-class="tap-button-hover" bindtap="loadMorePredictions">加载更多</button>
      </view>
    </view>

    <view class="section" wx:if="{{playerLeaderboard.length}}">
      <view class="section-head">
        <text class="section-title">选手日榜</text>
        <text class="section-note">{{playerVisibleCount}} / {{playerTotalCount}} 人</text>
      </view>
      <view class="stack">
        <view class="list-card tap-card" hover-class="tap-card-hover" wx:for="{{visiblePlayerLeaderboard}}" wx:key="player_id" data-player-id="{{item.player_id}}" bindtap="openPlayer">
          <text class="rank">{{item.rank}}</text>
          <view class="list-main">
            <view class="player-name-line">
              <text class="list-title">{{item.display_name}}</text>
              <star-player-badge wx:if="{{item.is_star_player}}" compact="{{true}}" />
            </view>
            <text class="list-meta">{{item.team_name || "未绑定战队"}} · {{item.games_played}} 局 · 胜率 {{item.win_rate}}</text>
          </view>
          <view class="list-score">
            <text class="score-value">{{item.points_total}}</text>
            <text class="score-label">实际分</text>
          </view>
          <text class="tap-cue">›</text>
        </view>
      </view>
      <view class="button-row" wx:if="{{playerHasMore}}">
        <button class="ghost-button" hover-class="tap-button-hover" bindtap="loadMorePlayers">加载更多</button>
      </view>
    </view>

    <view class="section" wx:if="{{teamLeaderboard.length}}">
      <view class="section-head">
        <text class="section-title">门派日榜</text>
        <text class="section-note">{{teamLeaderboard.length}} 支</text>
      </view>
      <view class="stack">
        <view class="list-card" wx:for="{{teamLeaderboard}}" wx:key="name">
          <text class="rank">{{item.rank}}</text>
          <view class="list-main">
            <text class="list-title">{{item.name}}</text>
            <text class="list-meta">出赛 {{item.matches_represented}} 场 · 胜率 {{item.win_rate}}</text>
          </view>
          <view class="list-score">
            <text class="score-value">{{item.points_total}}</text>
            <text class="score-label">积分</text>
          </view>
        </view>
      </view>
    </view>

    <view class="section" wx:if="{{competitions.length}}">
      <view class="section-head">
        <text class="section-title">当天赛程</text>
        <text class="section-note">{{competitions.length}} 组</text>
      </view>
      <view class="stack">
        <view class="competition-section" wx:for="{{competitions}}" wx:key="scope_key">
          <text class="competition-title">{{item.competition_name}}</text>
          <text class="competition-copy">{{item.season_name || "赛季未设置"}}</text>
          <text class="competition-copy">{{item.copy}}</text>
          <view class="match-card" wx:for="{{item.matches}}" wx:for-item="match" wx:key="match_id">
            <text class="match-title">{{match.stage_label || match.stage || "赛段未设置"}} · 第{{match.round}}轮第{{match.game_no}}局</text>
            <text class="match-meta">{{match.meta_text || "待补录"}}</text>
            <view class="match-groups" wx:if="{{match.group_labels && match.group_labels.length}}">
              <text class="match-group" wx:for="{{match.group_labels}}" wx:for-item="group" wx:key="*this">{{group}}</text>
            </view>
            <view class="participant-row" wx:for="{{match.participants}}" wx:for-item="player" wx:key="seat">
              <view class="player-name-line">
                <text>{{player.seat}}号 {{player.player_name}}</text>
                <star-player-badge wx:if="{{player.is_star_player}}" compact="{{true}}" />
              </view>
              <text>{{player.points}} 分</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </block>
</view>

.competition-section,
.match-card {
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.06);
}

.competition-section {
  padding: 24rpx;
}

.competition-title,
.competition-copy,
.match-title,
.match-meta {
  display: block;
}

.competition-title {
  font-size: 30rpx;
  font-weight: 800;
}

.competition-copy,
.match-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: #64748b;
}

.match-card {
  margin-top: 18rpx;
  padding: 20rpx;
  box-shadow: none;
  background: #f8fafc;
}

.match-title {
  font-size: 26rpx;
  font-weight: 800;
}

.match-groups {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.match-group {
  padding: 6rpx 12rpx;
  border: 1rpx solid #cbd5e1;
  border-radius: 999rpx;
  font-size: 19rpx;
  font-weight: 900;
  color: #334155;
  background: #f1f5f9;
}

.participant-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  padding: 12rpx 0;
  border-top: 1rpx solid #e2e8f0;
  font-size: 22rpx;
  color: #334155;
}

.participant-row:first-of-type {
  margin-top: 14rpx;
}

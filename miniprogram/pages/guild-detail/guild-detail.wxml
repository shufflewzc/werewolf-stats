<view class="page">
  <view class="hero">
    <text class="eyebrow">{{guild.short_name || "Guild"}}</text>
    <text class="title">{{needsCompetition ? "先进入赛事" : (guild.name || "门派详情")}}</text>
    <text class="copy" wx:if="{{needsCompetition}}">必须先选择赛事，之后才能查看该赛事上下文里的门派详情。</text>
    <text class="copy" wx:else>{{guild.notes || "查看门派赛季队伍、比赛覆盖和荣誉归档。"}}</text>
  </view>

  <view wx:if="{{loading}}" class="section">
    <view class="empty-card">
      <text class="empty-title">正在加载</text>
      <text class="empty-copy">正在读取门派详情。</text>
    </view>
  </view>

  <view wx:elif="{{error}}" class="section">
    <view class="error-card">
      <text>{{error}}</text>
      <view class="button-row">
        <button class="ghost-button" hover-class="tap-button-hover" bindtap="loadData">重试</button>
      </view>
    </view>
  </view>

  <block wx:else>
    <view class="section" wx:if="{{needsCompetition}}">
      <view class="empty-card">
        <text class="empty-title">先进入赛事</text>
        <text class="empty-copy">选择赛事后，才能查看门派详情和赛事内数据。</text>
        <view class="button-row">
          <button class="primary-button" hover-class="tap-button-hover" bindtap="goCompetitions">去选择赛事</button>
        </view>
      </view>
    </view>

    <block wx:if="{{!needsCompetition}}">
    <view class="section">
      <view class="scope-bar">
        <view class="scope-main">
          <text class="scope-label">当前赛事</text>
          <text class="scope-title">{{selectedScope.competition}}</text>
          <text class="scope-meta">{{selectedScope.region}} · {{selectedScope.seriesName || "系列赛"}} · {{selectedScope.season || "当前赛季"}}</text>
        </view>
        <button class="scope-button" hover-class="tap-button-hover" bindtap="changeCompetition">切换</button>
      </view>
      <view class="quick-actions">
        <button class="ghost-button" hover-class="tap-button-hover" bindtap="goGuilds">门派列表</button>
        <button class="ghost-button" hover-class="tap-button-hover" bindtap="goCompetitions">赛事入口</button>
      </view>
    </view>

    <view class="section">
      <view class="overview-grid">
        <view class="overview-card" wx:for="{{overviewCards}}" wx:key="label">
          <text class="metric-label">{{item.label}}</text>
          <text class="metric-value">{{item.value}}</text>
          <text class="metric-copy">{{item.copy}}</text>
        </view>
      </view>
    </view>

    <view class="section" wx:if="{{topHistoryTeams.length}}">
      <view class="section-head">
        <text class="section-title">代表队伍</text>
        <text class="section-note">Top {{topHistoryTeams.length}}</text>
      </view>
      <view class="stack">
        <view class="featured-team" wx:for="{{topHistoryTeams}}" wx:key="team_id">
          <view class="list-main">
            <text class="list-title">{{item.team_name}}</text>
            <text class="list-meta">{{item.competition_name}} · {{item.season_name}} · {{item.matches}} 场</text>
          </view>
          <view class="list-score">
            <text class="score-value">{{item.points_total}}</text>
            <text class="score-label">积分</text>
          </view>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-head">
        <text class="section-title">进行中赛季队伍</text>
        <text class="section-note">{{ongoingTeams.length}} 支</text>
      </view>
      <view class="stack" wx:if="{{ongoingTeams.length}}">
        <view class="list-card" wx:for="{{ongoingTeams}}" wx:key="team_id">
          <view class="list-main">
            <text class="list-title">{{item.team_name}}</text>
            <text class="list-meta">{{item.competition_name}} · {{item.season_name}} · {{item.player_count}} 人</text>
          </view>
          <view class="list-score">
            <text class="score-value">{{item.points_total}}</text>
            <text class="score-label">积分</text>
          </view>
        </view>
      </view>
      <view class="empty-card" wx:else>
        <text class="empty-title">暂无进行中队伍</text>
      </view>
    </view>

    <view class="section" wx:if="{{honors.length}}">
      <view class="section-head">
        <text class="section-title">历届荣誉</text>
        <text class="section-note">{{honors.length}} 条</text>
      </view>
      <view class="stack">
        <view class="honor-card" wx:for="{{honors}}" wx:key="key">
          <text class="honor-title">{{item.title}}</text>
          <text class="honor-meta">{{item.team_name}} · {{item.scope}}</text>
        </view>
      </view>
    </view>

    <view class="section" wx:if="{{historySections.length}}">
      <view class="section-head">
        <text class="section-title">历史赛季</text>
      </view>
      <view class="history-section" wx:for="{{historySections}}" wx:key="competition_name">
        <view class="history-head">
          <text class="history-title">{{item.competition_name}}</text>
          <text class="history-note">{{item.team_count}} 支 · {{item.points_total}} 分</text>
        </view>
        <view class="history-row" wx:for="{{item.rows}}" wx:for-item="team" wx:key="team_id">
          <view class="list-main">
            <text class="list-title">{{team.team_name}}</text>
            <text class="list-meta">{{team.season_name}} · {{team.status_label}} · {{team.matches}} 场</text>
          </view>
          <view class="list-score">
            <text class="score-value">{{team.points_total}}</text>
            <text class="score-label">积分</text>
          </view>
        </view>
      </view>
    </view>
    </block>
  </block>
</view>

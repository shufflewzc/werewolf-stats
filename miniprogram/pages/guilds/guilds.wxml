<view class="page">
  <view class="hero">
    <text class="eyebrow">Guilds</text>
    <text class="title">{{needsCompetition ? "先进入赛事" : (hero.title || "全部门派")}}</text>
    <text class="copy" wx:if="{{needsCompetition}}">必须先选择赛事，之后才能查看该赛事上下文里的门派与详情。</text>
    <text class="copy" wx:else>{{hero.copy || "查看长期门派组织、赛季身份和荣誉归档。"}}</text>
  </view>

  <view wx:if="{{loading}}" class="section">
    <view class="empty-card">
      <text class="empty-title">正在加载</text>
      <text class="empty-copy">正在读取门派列表。</text>
    </view>
  </view>

  <view wx:elif="{{error}}" class="section">
    <view class="error-card">
      <text>{{error}}</text>
      <view class="button-row">
        <button class="ghost-button" bindtap="loadData">重试</button>
      </view>
    </view>
  </view>

  <block wx:else>
    <view class="section" wx:if="{{needsCompetition}}">
      <view class="empty-card">
        <text class="empty-title">先进入赛事</text>
        <text class="empty-copy">选择赛事后，门派列表、门派详情和赛事数据会跟随当前赛事。</text>
        <view class="button-row">
          <button class="primary-button" bindtap="goCompetitions">去选择赛事</button>
        </view>
      </view>
    </view>

    <block wx:if="{{!needsCompetition}}">
    <view class="section">
      <view class="scope-bar">
        <view class="scope-main">
          <text class="scope-label">当前赛事</text>
          <text class="scope-title">{{selectedScope.competition}}</text>
          <text class="scope-meta">{{selectedScope.region}} · {{selectedScope.seriesName || "系列赛"}} · {{selectedScope.season || "当前赛季"}}</text>
        </view>
        <button class="scope-button" bindtap="changeCompetition">切换</button>
      </view>
    </view>

    <view class="section">
      <view class="metrics">
        <view class="metric-card" wx:for="{{metrics}}" wx:key="label">
          <text class="metric-label">{{item.label}}</text>
          <text class="metric-value">{{item.value}}</text>
          <text class="metric-copy">{{item.copy}}</text>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-head">
        <text class="section-title">门派列表</text>
        <text class="section-note">{{guilds.length}} 个</text>
      </view>
      <view class="stack" wx:if="{{guilds.length}}">
        <view class="guild-card" wx:for="{{guilds}}" wx:key="guild_id" data-guild-id="{{item.guild_id}}" bindtap="openGuildDetail">
          <text class="guild-kicker">{{item.short_name || "门派"}}</text>
          <text class="guild-title">{{item.name}}</text>
          <text class="guild-copy">{{item.notes}}</text>
          <view class="guild-stats">
            <view>
              <text class="guild-stat-value">{{item.ongoing_team_count}}</text>
              <text class="guild-stat-label">进行中队伍</text>
            </view>
            <view>
              <text class="guild-stat-value">{{item.match_count}}</text>
              <text class="guild-stat-label">覆盖比赛</text>
            </view>
            <view>
              <text class="guild-stat-value">{{item.honor_count}}</text>
              <text class="guild-stat-label">荣誉</text>
            </view>
          </view>
          <text class="enter-label">查看详情</text>
        </view>
      </view>
      <view class="empty-card" wx:else>
        <text class="empty-title">暂无门派</text>
        <text class="empty-copy">网站后台登记门派后，这里会显示公开入口。</text>
      </view>
    </view>
    </block>
  </block>
</view>

.guild-card {
  padding: 26rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.06);
}

.guild-kicker,
.guild-copy,
.guild-stat-label {
  display: block;
  font-size: 22rpx;
  color: #64748b;
}

.guild-title {
  display: block;
  margin-top: 10rpx;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.25;
}

.guild-copy {
  margin-top: 10rpx;
  line-height: 1.5;
}

.guild-stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 22rpx;
}

.guild-stats view {
  padding: 16rpx;
  border-radius: 12rpx;
  background: #f8fafc;
}

.guild-stat-value {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
}

.enter-label {
  display: block;
  margin-top: 20rpx;
  height: 64rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 64rpx;
  text-align: center;
  color: #ffffff;
  background: #111827;
}

<view class="page">
  <view class="hero">
    <text class="eyebrow">Account</text>
    <text class="title">我的赛事中心</text>
    <text class="copy">登录、绑定选手、查看当前赛事和个人选手页，都从这里进入。</text>
  </view>

  <view class="section" wx:if="{{error}}">
    <view class="error-card">
      <text>{{error}}</text>
    </view>
  </view>

  <view class="section" wx:if="{{user}}">
    <view class="center-card">
      <view class="center-head">
        <view>
          <text class="center-kicker">当前状态</text>
          <text class="center-title">{{centerStatus}}</text>
        </view>
        <button class="scope-button scope-switch-button" hover-class="tap-button-hover" bindtap="goCompetitions">{{selectedScope ? "切换赛事" : "选赛事"}}</button>
      </view>

      <view class="scope-mini" wx:if="{{selectedScope}}">
        <text class="account-label">当前赛事</text>
        <text class="account-name">{{selectedScope.competition}}</text>
        <text class="account-meta">{{selectedScope.region}} · {{selectedScope.seriesName || "系列赛"}} · {{selectedScope.season || "当前赛季"}}</text>
      </view>

      <view class="scope-mini" wx:else>
        <text class="account-label">当前赛事</text>
        <text class="account-name">尚未进入赛事</text>
        <text class="account-meta">先选择赛事后，才能查看我的选手页和比赛日。</text>
      </view>

      <view class="my-player-row" wx:if="{{currentPlayer}}">
        <view class="list-main">
          <text class="account-label">本赛季选手</text>
          <text class="account-name">{{currentPlayer.display_name}}</text>
          <text class="account-meta">{{currentPlayer.team_name || "未绑定战队"}} · {{currentPlayer.season}}</text>
          <text class="account-meta">账号名：{{user.display_name || user.username}}</text>
          <text class="account-meta">{{latestDay ? latestDay.played_on : "暂无比赛日"}} · {{centerCopy}}</text>
        </view>
        <button class="scope-button" hover-class="tap-button-hover" bindtap="openMyPlayerPage">查看</button>
      </view>

      <view class="empty-inline" wx:if="{{!currentPlayer}}">
        <text>{{centerCopy}}</text>
      </view>

      <view class="bound-player-list" wx:if="{{boundPlayers.length}}">
        <text class="account-label">已绑定档案</text>
        <view class="bound-player-item tap-card" hover-class="tap-card-hover" wx:for="{{boundPlayers}}" wx:key="player_id" data-player-id="{{item.player_id}}" bindtap="openBoundPlayerPage">
          <view class="list-main">
            <text class="bound-player-name">{{item.display_name || item.player_id}}</text>
            <text class="bound-player-id">{{item.competition || "未分配赛事"}} · {{item.season || "未分配赛季"}}</text>
          </view>
          <text class="bound-player-action">详情</text>
          <text class="tap-cue">›</text>
        </view>
      </view>

      <view class="quick-actions">
        <button class="primary-button" hover-class="tap-button-hover" wx:if="{{currentPlayer}}" bindtap="openMyPlayerPage">我的选手页</button>
        <button class="primary-button" hover-class="tap-button-hover" wx:else bindtap="goBindPlayer">{{currentPlayerStatus === "conflict" ? "管理绑定" : "绑定选手"}}</button>
        <button class="ghost-button" hover-class="tap-button-hover" bindtap="openLatestDay">比赛日</button>
        <button class="ghost-button" hover-class="tap-button-hover" bindtap="openPrediction">当日预测</button>
      </view>
    </view>
  </view>

  <view class="section" wx:if="{{user}}">
    <view class="account-card">
      <text class="account-label">当前账号</text>
      <text class="account-name">{{user.display_name}}</text>
      <text class="account-meta">@{{user.username}} · {{user.role}}</text>
      <text class="account-meta">绑定状态：{{user.wechat_bound ? "已绑定微信" : "未绑定微信"}}</text>
      <view class="bound-status {{boundPlayers.length ? 'bound-status-active' : ''}}">
        <text class="bound-status-label">绑定选手</text>
        <text class="bound-status-value">{{boundPlayerLabel || "未绑定"}}</text>
      </view>
      <button class="primary-button single-button" hover-class="tap-button-hover" loading="{{loading}}" bindtap="scanWebLogin">扫码登录网页端</button>
      <button class="ghost-button single-button" hover-class="tap-button-hover" bindtap="goBindPlayer">搜索中文名绑定选手</button>
      <button class="ghost-button single-button" hover-class="tap-button-hover" bindtap="logout">退出本地登录</button>
    </view>
  </view>

  <view class="section" wx:else>
    <view class="empty-card">
      <text class="empty-title">尚未登录</text>
      <text class="empty-copy">点击后会使用微信身份登录；如果没有对应账号，系统会自动创建一个普通账号。</text>
      <view class="button-row">
        <button class="primary-button" hover-class="tap-button-hover" loading="{{loading}}" bindtap="login">微信登录</button>
      </view>
    </view>
  </view>

  <view class="section" wx:if="{{selectedScope && followedPlayers.length}}">
    <view class="follow-card">
      <view class="follow-head">
        <view>
          <text class="account-label">当前赛事</text>
          <text class="follow-title">我的关注</text>
        </view>
        <text class="follow-count">{{followedPlayers.length}} 人</text>
      </view>
      <view class="follow-list">
        <view class="follow-item tap-card" hover-class="tap-card-hover" wx:for="{{followedPlayers}}" wx:key="player_id" data-player-id="{{item.player_id}}" bindtap="openFollowedPlayer">
          <view class="list-main">
            <text class="bound-player-name">{{item.display_name}}</text>
            <text class="account-meta">{{item.team_name || "未绑定战队"}}</text>
          </view>
          <button class="follow-remove" hover-class="tap-button-hover" data-player-id="{{item.player_id}}" catchtap="removeFollowedPlayer">取消关注</button>
          <text class="tap-cue">›</text>
        </view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="form-card" wx:if="{{user}}">
      <text class="form-title">完善资料</text>
      <text class="form-copy">用于展示个人资料和后续认领流程。绑定选手请进入单独搜索页。</text>
      <input class="input" value="{{profile.display_name}}" data-field="display_name" placeholder="显示名称" bindinput="updateProfileField" />
      <view class="grid-inputs">
        <input class="input" value="{{profile.province_name}}" data-field="province_name" placeholder="省份，例如 广东省" bindinput="updateProfileField" />
        <input class="input" value="{{profile.region_name}}" data-field="region_name" placeholder="城市，例如 广州市" bindinput="updateProfileField" />
      </view>
      <picker mode="selector" range="{{genderLabels}}" bindchange="updateGender">
        <view class="picker-field" hover-class="tap-chip-hover">性别：{{genderLabel}}</view>
      </picker>
      <textarea class="textarea" value="{{profile.bio}}" data-field="bio" placeholder="个人简介" bindinput="updateProfileField"></textarea>
      <button class="primary-button single-button" hover-class="tap-button-hover" loading="{{loading}}" bindtap="saveProfile">保存资料</button>
    </view>
  </view>

</view>

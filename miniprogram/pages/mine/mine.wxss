.account-card,
.form-card {
  padding: 28rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.06);
}

.account-label,
.account-meta,
.form-copy {
  display: block;
  font-size: 23rpx;
  color: #64748b;
}

.account-name,
.form-title {
  display: block;
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.25;
}

.account-meta,
.form-copy {
  margin-top: 10rpx;
  line-height: 1.5;
}

.input {
  height: 78rpx;
  margin-top: 18rpx;
  padding: 0 22rpx;
  border: 1rpx solid #cbd5e1;
  border-radius: 12rpx;
  background: #f8fafc;
  box-sizing: border-box;
  font-size: 26rpx;
}

.single-button {
  width: 100%;
  margin-top: 22rpx;
}

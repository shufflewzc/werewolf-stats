.account-card,
.form-card,
.center-card {
  padding: 28rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.06);
}

.center-head,
.my-player-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.center-kicker,
.center-title {
  display: block;
}

.center-kicker {
  font-size: 22rpx;
  color: #64748b;
}

.center-title {
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 800;
}

.scope-mini,
.my-player-row,
.bound-player-list,
.empty-inline {
  margin-top: 22rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  background: #f8fafc;
}

.empty-inline {
  font-size: 23rpx;
  line-height: 1.5;
  color: #64748b;
}

.account-label,
.account-meta,
.form-copy {
  display: block;
  font-size: 23rpx;
  color: #64748b;
}

.account-name,
.form-title {
  display: block;
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.25;
}

.account-meta,
.form-copy {
  margin-top: 10rpx;
  line-height: 1.5;
}

.bound-status {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 12rpx;
  background: #f8fafc;
}

.bound-status-active {
  background: #ecfdf5;
}

.bound-status-label,
.bound-status-value {
  display: block;
}

.bound-status-label {
  font-size: 22rpx;
  color: #64748b;
}

.bound-status-value {
  margin-top: 6rpx;
  font-size: 28rpx;
  font-weight: 800;
  color: #0f172a;
}

.bound-player-list {
  padding: 0 20rpx;
}

.bound-player-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 82rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid #e2e8f0;
}

.bound-player-item:first-child {
  border-top: 0;
}

.bound-player-name,
.bound-player-id {
  display: block;
}

.bound-player-name {
  font-size: 27rpx;
  font-weight: 800;
  color: #0f172a;
}

.bound-player-id {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #64748b;
}

.bound-player-action {
  flex: 0 0 auto;
  font-size: 23rpx;
  font-weight: 700;
  color: #2563eb;
}

.input {
  height: 78rpx;
  margin-top: 18rpx;
  padding: 0 22rpx;
  border: 1rpx solid #cbd5e1;
  border-radius: 12rpx;
  background: #f8fafc;
  box-sizing: border-box;
  font-size: 26rpx;
}

.grid-inputs {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.picker-field,
.textarea {
  margin-top: 18rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #cbd5e1;
  border-radius: 12rpx;
  background: #f8fafc;
  box-sizing: border-box;
  font-size: 26rpx;
}

.textarea {
  width: 100%;
  min-height: 150rpx;
}

.single-button {
  width: 100%;
  margin-top: 22rpx;
}

.quick-actions {
  margin-top: 22rpx;
}

.achievement-panel {
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #e2e8f0;
}

.compact-head {
  margin-bottom: 14rpx;
}

.achievement-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.achievement-card {
  min-height: 164rpx;
  padding: 18rpx;
  border: 1rpx solid #dbeafe;
  border-radius: 14rpx;
  box-sizing: border-box;
  background: #f8fbff;
}

.achievement-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}

.achievement-code,
.achievement-tier,
.achievement-title,
.achievement-copy,
.achievement-meta {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.achievement-code {
  max-width: 128rpx;
  font-size: 20rpx;
  font-weight: 800;
  color: #2563eb;
}

.achievement-tier {
  flex: 0 0 auto;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  font-weight: 800;
  color: #1d4ed8;
  background: #dbeafe;
}

.achievement-title {
  margin-top: 12rpx;
  font-size: 26rpx;
  font-weight: 800;
  color: #0f172a;
}

.achievement-copy {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #475569;
}

.achievement-meta {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #64748b;
}

.achievement-card.tier-legend,
.achievement-card.tier-gold {
  border-color: #facc15;
  background: #fffbeb;
}

.achievement-card.tier-legend .achievement-code,
.achievement-card.tier-gold .achievement-code,
.achievement-card.tier-legend .achievement-tier,
.achievement-card.tier-gold .achievement-tier {
  color: #92400e;
}

.achievement-card.tier-legend .achievement-tier,
.achievement-card.tier-gold .achievement-tier {
  background: #fef3c7;
}

.achievement-card.tier-silver {
  border-color: #cbd5e1;
  background: #f8fafc;
}

.achievement-card.tier-bronze {
  border-color: #fed7aa;
  background: #fff7ed;
}

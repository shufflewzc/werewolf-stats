.account-card,
.form-card,
.center-card,
.follow-card {
  padding: 28rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.06);
}

.center-head,
.my-player-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.center-kicker,
.center-title {
  display: block;
}

.center-kicker {
  font-size: 22rpx;
  color: #64748b;
}

.center-title {
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 800;
}

.scope-mini,
.my-player-row,
.bound-player-list,
.empty-inline {
  margin-top: 22rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  background: #f8fafc;
}

.empty-inline {
  font-size: 23rpx;
  line-height: 1.5;
  color: #64748b;
}

.account-label,
.account-meta,
.form-copy {
  display: block;
  font-size: 23rpx;
  color: #64748b;
}

.account-name,
.form-title {
  display: block;
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.25;
}

.account-meta,
.form-copy {
  margin-top: 10rpx;
  line-height: 1.5;
}

.bound-status {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 12rpx;
  background: #f8fafc;
}

.bound-status-active {
  background: #ecfdf5;
}

.bound-status-label,
.bound-status-value {
  display: block;
}

.bound-status-label {
  font-size: 22rpx;
  color: #64748b;
}

.bound-status-value {
  margin-top: 6rpx;
  font-size: 28rpx;
  font-weight: 800;
  color: #0f172a;
}

.bound-player-list {
  padding: 0 20rpx;
}

.bound-player-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 82rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid #e2e8f0;
}

.bound-player-item:first-child {
  border-top: 0;
}

.follow-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.follow-title {
  display: block;
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.25;
}

.follow-count {
  flex: 0 0 auto;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #fef3c7;
  color: #92400e;
  font-size: 22rpx;
  font-weight: 700;
}

.follow-list {
  margin-top: 22rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  background: #f8fafc;
}

.follow-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 88rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid #e2e8f0;
}

.follow-item:first-child {
  border-top: 0;
}

.follow-remove {
  flex: 0 0 auto;
  margin: 0;
  padding: 8rpx 12rpx;
  border: 1rpx solid #cbd5e1;
  border-radius: 999rpx;
  background: #ffffff;
  color: #475569;
  font-size: 21rpx;
  line-height: 1.35;
}

.bound-player-name,
.bound-player-id {
  display: block;
}

.bound-player-name {
  font-size: 27rpx;
  font-weight: 800;
  color: #0f172a;
}

.bound-player-id {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #64748b;
}

.bound-player-action {
  flex: 0 0 auto;
  font-size: 23rpx;
  font-weight: 700;
  color: #2563eb;
}

.input {
  height: 78rpx;
  margin-top: 18rpx;
  padding: 0 22rpx;
  border: 1rpx solid #cbd5e1;
  border-radius: 12rpx;
  background: #f8fafc;
  box-sizing: border-box;
  font-size: 26rpx;
}

.grid-inputs {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.picker-field,
.textarea {
  margin-top: 18rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #cbd5e1;
  border-radius: 12rpx;
  background: #f8fafc;
  box-sizing: border-box;
  font-size: 26rpx;
}

.textarea {
  width: 100%;
  min-height: 150rpx;
}

.single-button {
  width: 100%;
  margin-top: 22rpx;
}

.quick-actions {
  margin-top: 22rpx;
}

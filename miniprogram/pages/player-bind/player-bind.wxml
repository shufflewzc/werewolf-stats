<view class="page">
  <view class="hero">
    <text class="eyebrow">Bind Player</text>
    <text class="title">绑定选手</text>
    <text class="copy">输入选手中文名搜索，再从结果里选择绑定。无需手填系统 ID。</text>
  </view>

  <view class="section" wx:if="{{error}}">
    <view class="error-card">
      <text>{{error}}</text>
    </view>
  </view>

  <view class="section">
    <view class="search-card">
      <view class="bind-current" wx:if="{{boundPlayers.length}}">
        <text class="bind-current-label">当前已绑定选手</text>
        <view class="bind-current-list">
          <view class="bind-current-item" wx:for="{{boundPlayers}}" wx:key="player_id">
            <view class="bind-current-main">
              <view class="player-name-line">
                <text class="bind-current-value">{{item.display_name || item.player_id}}</text>
                <star-player-badge wx:if="{{item.is_star_player}}" compact="{{true}}" />
              </view>
              <text class="bind-current-id">{{item.competition || "未分配赛事"}} · {{item.season || "未分配赛季"}}</text>
            </view>
            <button class="unbind-button" hover-class="tap-button-hover" data-player-id="{{item.player_id}}" bindtap="unbind">解绑</button>
          </view>
        </view>
      </view>
      <input class="input" value="{{keyword}}" placeholder="输入中文名，例如 琛" bindinput="updateKeyword" confirm-type="search" bindconfirm="search" />
      <button class="primary-button single-button" hover-class="tap-button-hover" loading="{{loading}}" bindtap="search">搜索</button>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <text class="section-title">搜索结果</text>
      <text class="section-note">{{players.length}} 个</text>
    </view>
    <view class="stack" wx:if="{{players.length}}">
      <view class="player-card" wx:for="{{players}}" wx:key="player_id">
        <view class="list-main">
          <view class="player-name-line">
            <text class="list-title">{{item.display_name}}</text>
            <star-player-badge wx:if="{{item.is_star_player}}" compact="{{true}}" />
          </view>
          <text class="list-meta">{{item.team_name}} · {{item.aliases_text || "无别名"}}</text>
          <text class="bind-state">{{item.bound_to_self ? "已绑定到当前账号" : (item.bound ? "已被其他账号绑定" : "可绑定")}}</text>
        </view>
        <button class="bind-button" hover-class="tap-button-hover" disabled="{{item.bound && !item.bound_to_self}}" data-player-id="{{item.player_id}}" bindtap="bind">
          {{item.bound_to_self ? "已绑定" : "绑定"}}
        </button>
      </view>
    </view>
    <view class="empty-card" wx:else>
      <text class="empty-title">暂无结果</text>
      <text class="empty-copy">请输入中文名搜索选手。</text>
    </view>
  </view>
</view>

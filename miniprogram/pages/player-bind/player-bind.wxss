.search-card,
.player-card {
  padding: 24rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.06);
}

.input {
  height: 78rpx;
  padding: 0 22rpx;
  border: 1rpx solid #cbd5e1;
  border-radius: 12rpx;
  background: #f8fafc;
  box-sizing: border-box;
  font-size: 26rpx;
}

.bind-current {
  margin-bottom: 18rpx;
  padding: 18rpx;
  border-radius: 12rpx;
  background: #f8fafc;
}

.bind-current-label,
.bind-current-value {
  display: block;
}

.bind-current-label {
  font-size: 22rpx;
  color: #64748b;
}

.bind-current-value {
  margin-top: 6rpx;
  font-size: 28rpx;
  font-weight: 800;
  color: #0f172a;
}

.bind-current-list {
  margin-top: 8rpx;
}

.bind-current-item {
  padding: 10rpx 0;
  border-top: 1rpx solid #e2e8f0;
}

.bind-current-item:first-child {
  border-top: 0;
}

.bind-current-id {
  display: block;
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #64748b;
}

.player-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.bind-state {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #64748b;
}

.bind-button {
  flex: 0 0 132rpx;
  width: 132rpx;
  height: 64rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 64rpx;
  color: #ffffff;
  background: #111827;
}

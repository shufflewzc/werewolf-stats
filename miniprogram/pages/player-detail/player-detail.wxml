<view class="page">
  <view class="detail-hero">
    <image wx:if="{{player.photoUrl}}" class="detail-avatar" src="{{player.photoUrl}}" mode="aspectFill" binderror="onPlayerImageError"></image>
    <view wx:else class="detail-avatar image-placeholder"></view>
    <view class="detail-main">
      <text class="detail-eyebrow">{{player.team_name || "未绑定战队"}}</text>
      <text class="detail-name">{{player.name || "选手详情"}}</text>
      <text class="detail-copy">排名 #{{player.rank || "-"}} · {{player.owner || "未绑定账号"}}</text>
      <view wx:if="{{player.power_rating}}" class="power-rating-badge {{player.power_rating.class_name}}">
        <text>战力 {{player.power_rating.grade}}</text>
        <text class="power-rating-source">{{player.power_rating.source_label}}</text>
      </view>
      <button class="follow-button" hover-class="tap-button-hover" wx:if="{{selectedScope && selectedScope.competition}}" bindtap="toggleFollow">{{followed ? "已关注" : "关注选手"}}</button>
    </view>
  </view>

  <view wx:if="{{loading}}" class="section">
    <view class="empty-card">
      <text class="empty-title">正在加载</text>
      <text class="empty-copy">正在读取选手详情。</text>
    </view>
  </view>

  <view wx:elif="{{needsCompetition}}" class="section">
    <view class="empty-card">
      <text class="empty-title">先进入赛事</text>
      <text class="empty-copy">选择赛事后，才能查看该赛事范围下的选手详情和维度数据。</text>
      <view class="button-row">
        <button class="primary-button" hover-class="tap-button-hover" bindtap="goCompetitions">去选择赛事</button>
      </view>
    </view>
  </view>

  <view wx:elif="{{error}}" class="section">
    <view class="error-card">
      <text>{{error}}</text>
      <view class="button-row">
        <button class="ghost-button" hover-class="tap-button-hover" bindtap="loadData">重试</button>
      </view>
    </view>
  </view>

  <block wx:else>
    <view class="section" wx:if="{{selectedScope && selectedScope.competition}}">
      <view class="scope-bar">
        <view class="scope-main">
          <text class="scope-label">当前赛事</text>
          <text class="scope-title">{{selectedScope.competition}}</text>
          <text class="scope-meta">{{selectedScope.region}} · {{selectedScope.seriesName || "系列赛"}} · {{selectedScope.season || "当前赛季"}}</text>
        </view>
        <button class="scope-button" hover-class="tap-button-hover" bindtap="changeCompetition">切换</button>
      </view>
      <view class="quick-actions">
        <button class="ghost-button" hover-class="tap-button-hover" bindtap="goPlayers">选手榜</button>
        <button class="ghost-button" hover-class="tap-button-hover" bindtap="goPredictions">胜率预测</button>
        <button class="ghost-button" hover-class="tap-button-hover" bindtap="openCompare">选手对比</button>
        <button class="ghost-button" hover-class="tap-button-hover" bindtap="openShareCard">生成战绩卡</button>
      </view>
    </view>

    <view class="section" wx:if="{{summaryCards.length}}">
      <view class="summary-strip">
        <view class="summary-card" wx:for="{{summaryCards}}" wx:key="label">
          <text class="summary-label">{{item.label}}</text>
          <text class="summary-value">{{item.value}}</text>
          <text class="summary-copy">{{item.copy}}</text>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="metrics">
        <view class="metric-card" wx:for="{{metrics}}" wx:key="label">
          <text class="metric-label">{{item.label}}</text>
          <text class="metric-value">{{item.value}}</text>
          <text class="metric-copy">{{item.copy}}</text>
        </view>
      </view>
    </view>

    <view class="section" wx:if="{{achievements.length}}">
      <view class="section-head">
        <text class="section-title">成就标签</text>
        <text class="section-note">{{achievements.length}} 个</text>
      </view>
      <view class="achievement-grid">
        <view class="achievement-card {{item.className}}" wx:for="{{achievements}}" wx:key="code">
          <view class="achievement-top">
            <text class="achievement-code">{{item.code}}</text>
            <text class="achievement-tier">{{item.tierLabel}}</text>
          </view>
          <text class="achievement-title">{{item.title}}</text>
          <text class="achievement-meta">{{item.meta || item.description}}</text>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-head">
        <text class="section-title">胜率画像</text>
      </view>
      <view class="insight-card">
        <view class="insight-row">
          <text>综合胜率</text>
          <text>{{insights.overall_win_rate || "--"}}</text>
        </view>
        <view class="bar"><view class="bar-fill" style="width: {{insights.overall_width || 0}}%;"></view></view>
        <view class="insight-row">
          <text>好人胜率</text>
          <text>{{insights.villagers_win_rate || "--"}}</text>
        </view>
        <view class="bar"><view class="bar-fill alt" style="width: {{insights.villagers_width || 0}}%;"></view></view>
        <view class="insight-row">
          <text>狼人胜率</text>
          <text>{{insights.werewolves_win_rate || "--"}}</text>
        </view>
        <view class="bar"><view class="bar-fill warm" style="width: {{insights.werewolves_width || 0}}%;"></view></view>
      </view>
    </view>

    <view class="section">
      <view class="section-head">
        <text class="section-title">维度数据</text>
        <text class="section-note">{{dimension.selected_season || ""}}</text>
      </view>
      <view wx:if="{{dimensionAvailable}}">
        <view class="metrics">
          <view class="metric-card" wx:for="{{dimension.summary_cards}}" wx:key="label">
            <text class="metric-label">{{item.label}}</text>
            <text class="metric-value">{{item.value}}</text>
          </view>
        </view>

        <view class="dimension-card">
          <text class="dimension-title">六维画像</text>
          <view class="radar-row" wx:for="{{dimension.radar}}" wx:key="label">
            <view class="radar-head">
              <text>{{item.label}}</text>
              <text>{{item.display}}</text>
            </view>
            <view class="bar"><view class="bar-fill" style="width: {{item.width}}%;"></view></view>
          </view>
        </view>

        <view class="dimension-card">
          <text class="dimension-title">每日维度记录</text>
          <view class="dimension-history" wx:for="{{dimension.history}}" wx:key="played_on">
            <view class="list-main">
              <text class="list-title">{{item.played_on}}</text>
              <text class="list-meta">{{item.team_name}} · 座位 {{item.seat}} · {{item.games_played}} 局 {{item.wins}} 胜</text>
            </view>
            <view class="list-score">
              <text class="score-value">{{item.daily_points}}</text>
              <text class="score-label">维度分</text>
            </view>
          </view>
        </view>
      </view>
      <view class="empty-card" wx:else>
        <text class="empty-title">暂无维度数据</text>
        <text class="empty-copy">{{dimension.reason || "当前赛事还没有导入该选手的维度补充数据。"}}</text>
      </view>
    </view>

    <view class="section" wx:if="{{roles.length}}">
      <view class="section-head">
        <text class="section-title">角色分布</text>
      </view>
      <view class="role-card" wx:for="{{roles}}" wx:key="role">
        <view class="insight-row">
          <text>{{item.role}}</text>
          <text>{{item.games}} 局 · {{item.share}}</text>
        </view>
        <view class="bar"><view class="bar-fill alt" style="width: {{item.width}}%;"></view></view>
      </view>
    </view>

    <view class="section" wx:if="{{recentMatches.length}}">
      <view class="section-head">
        <text class="section-title">最近比赛</text>
      </view>
      <view class="stack">
        <view class="list-card recent-match-card {{item.resultClass}}" wx:for="{{recentMatches}}" wx:key="match_id">
          <view class="list-main">
            <text class="list-title">{{item.played_on}} · 第{{item.round}}轮第{{item.game_no}}局</text>
            <text class="list-meta">{{item.role}} · {{item.resultText}} · {{item.competition_name}}</text>
          </view>
          <view class="list-score">
            <text class="score-value">{{item.points_earned}}</text>
            <text class="score-label">得分</text>
          </view>
        </view>
      </view>
    </view>
  </block>
</view>

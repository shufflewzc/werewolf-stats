.detail-hero {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx;
  border-radius: 16rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #111827 0%, #1e3a5f 62%, #be7c25 100%);
}

.detail-avatar {
  flex: 0 0 128rpx;
  width: 128rpx;
  height: 128rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.35);
  border-radius: 50%;
  background: #e2e8f0;
}

.detail-main {
  flex: 1;
  min-width: 0;
}

.detail-eyebrow,
.detail-copy {
  display: block;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.74);
}

.detail-name {
  display: block;
  margin-top: 8rpx;
  overflow: hidden;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-copy {
  margin-top: 10rpx;
}

.detail-main .power-rating-badge {
  margin-top: 14rpx;
}

.summary-strip {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.summary-card {
  min-height: 132rpx;
  padding: 18rpx 14rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  box-sizing: border-box;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.06);
}

.summary-label,
.summary-value,
.summary-copy {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.summary-label {
  font-size: 20rpx;
  color: #64748b;
}

.summary-value {
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.summary-copy {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #475569;
}

.insight-card,
.dimension-card,
.role-card {
  padding: 24rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.06);
}

.achievement-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.achievement-card {
  min-height: 168rpx;
  padding: 20rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  box-sizing: border-box;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.06);
}

.achievement-card.tier-legend {
  border-color: #f59e0b;
  background: #fffbeb;
}

.achievement-card.tier-gold {
  border-color: #facc15;
  background: #fefce8;
}

.achievement-card.tier-silver {
  border-color: #cbd5e1;
  background: #f8fafc;
}

.achievement-card.tier-bronze {
  border-color: #fdba74;
  background: #fff7ed;
}

.achievement-card.tier-locked {
  color: #64748b;
  background: #f8fafc;
}

.achievement-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}

.achievement-code,
.achievement-tier {
  display: block;
  overflow: hidden;
  font-size: 20rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.achievement-code {
  color: #0f172a;
}

.achievement-tier {
  flex: 0 0 auto;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: #111827;
}

.achievement-title,
.achievement-meta {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
}

.achievement-title {
  margin-top: 14rpx;
  font-size: 26rpx;
  font-weight: 800;
  color: #111827;
  white-space: nowrap;
}

.achievement-meta {
  margin-top: 8rpx;
  font-size: 21rpx;
  line-height: 1.45;
  color: #475569;
}

.role-card + .role-card {
  margin-top: 14rpx;
}

.insight-row,
.radar-head,
.dimension-history {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.insight-row,
.radar-head {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: #334155;
}

.insight-row:first-child,
.radar-row:first-of-type .radar-head {
  margin-top: 0;
}

.bar {
  height: 14rpx;
  margin-top: 12rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e2e8f0;
}

.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #111827;
}

.bar-fill.alt {
  background: #0f766e;
}

.bar-fill.warm {
  background: #b45309;
}

.dimension-title {
  display: block;
  margin-bottom: 18rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.dimension-card {
  margin-top: 18rpx;
}

.dimension-history {
  min-height: 92rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid #e2e8f0;
}

.dimension-history:first-of-type {
  border-top: 0;
}

.recent-match-card {
  position: relative;
  overflow: hidden;
  border-color: #e2e8f0;
}

.recent-match-card::before {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 8rpx;
  content: "";
  background: #94a3b8;
}

.recent-match-card.is-win {
  border-color: #bbf7d0;
  background: #f0fdf4;
}

.recent-match-card.is-win::before,
.recent-match-card.is-win .score-value {
  background: #16a34a;
}

.recent-match-card.is-win .score-value {
  color: #15803d;
  background: transparent;
}

.recent-match-card.is-loss {
  border-color: #fecaca;
  background: #fff7f7;
}

.recent-match-card.is-loss::before,
.recent-match-card.is-loss .score-value {
  background: #dc2626;
}

.recent-match-card.is-loss .score-value {
  color: #b91c1c;
  background: transparent;
}
.follow-button {
  display: inline-flex;
  width: auto;
  min-width: 132rpx;
  height: 56rpx;
  margin: 16rpx 0 0;
  padding: 0 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.55);
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 56rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.14);
}

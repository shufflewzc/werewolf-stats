<view class="page">
  <view class="hero">
    <text class="eyebrow">Players</text>
    <text class="title">选手排行榜</text>
    <text class="copy">{{scope.description || "查看选手积分、胜率和出场表现。"}}</text>
  </view>

  <view wx:if="{{loading}}" class="section">
    <view class="empty-card">
      <text class="empty-title">正在加载</text>
      <text class="empty-copy">正在读取选手排行。</text>
    </view>
  </view>

  <view wx:elif="{{error}}" class="section">
    <view class="error-card">
      <text>{{error}}</text>
      <view class="button-row">
        <button class="ghost-button" bindtap="loadData">重试</button>
      </view>
    </view>
  </view>

  <block wx:else>
    <view class="section" wx:if="{{needsCompetition}}">
      <view class="empty-card">
        <text class="empty-title">先进入赛事</text>
        <text class="empty-copy">选择赛事后，才能查看该赛事内的选手数据。</text>
        <view class="button-row">
          <button class="primary-button" bindtap="goCompetitions">去选择赛事</button>
        </view>
      </view>
    </view>

    <block wx:if="{{!needsCompetition}}">
      <view class="section">
        <view class="scope-bar">
          <view class="scope-main">
            <text class="scope-label">当前赛事</text>
            <text class="scope-title">{{selectedScope.competition}}</text>
            <text class="scope-meta">{{selectedScope.region}} · {{selectedScope.seriesName || "系列赛"}} · {{selectedScope.season || "当前赛季"}}</text>
          </view>
          <button class="scope-button" bindtap="changeCompetition">切换</button>
        </view>
      </view>

      <view class="section">
        <view class="metrics">
          <view class="metric-card" wx:for="{{metrics}}" wx:key="label">
            <text class="metric-label">{{item.label}}</text>
            <text class="metric-value">{{item.value}}</text>
            <text class="metric-copy">{{item.copy}}</text>
          </view>
        </view>
      </view>

      <view class="section">
        <view class="section-head">
          <text class="section-title">{{scope.label || "当前范围"}}</text>
          <text class="section-note">{{playerVisibleCount}} / {{playerTotalCount}} 名</text>
        </view>
        <view class="stack" wx:if="{{players.length}}">
          <view class="list-card player-row" wx:for="{{visiblePlayers}}" wx:key="player_id" data-player-id="{{item.player_id}}" bindtap="openPlayerDetail">
            <text class="rank">{{item.rank}}</text>
            <image class="avatar" src="{{item.photoUrl}}" mode="aspectFill"></image>
            <view class="list-main">
              <text class="list-title">{{item.display_name}}</text>
              <text class="list-meta">{{item.team_name}} · {{item.record}} · 胜率 {{item.win_rate}}</text>
            </view>
            <view class="list-score">
              <text class="score-value">{{item.points_total}}</text>
              <text class="score-label">积分</text>
            </view>
          </view>
        </view>
        <view class="button-row" wx:if="{{playerHasMore}}">
          <button class="ghost-button" bindtap="loadMorePlayers">加载更多</button>
        </view>
        <view class="empty-card" wx:if="{{!players.length}}">
          <text class="empty-title">暂无选手</text>
          <text class="empty-copy">录入比赛结果后，这里会显示选手排行。</text>
        </view>
      </view>
    </block>
  </block>
</view>

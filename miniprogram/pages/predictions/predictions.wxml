<view class="page">
  <view class="hero">
    <text class="eyebrow">Score Forecast</text>
    <text class="title">当天三局胜率预测</text>
    <text class="copy" wx:if="{{needsCompetition}}">必须先进入一个赛事，之后才能查看赛事内比赛日总分预测。</text>
    <text class="copy" wx:else>{{scope.label || "当前赛事"}} · {{scope.selected_season || "当前赛季"}} · 按比赛日汇总</text>
  </view>

  <view wx:if="{{loading}}" class="section">
    <view class="empty-card">
      <text class="empty-title">正在加载</text>
      <text class="empty-copy">正在读取比赛预测。</text>
    </view>
  </view>

  <view wx:elif="{{error}}" class="section">
    <view class="error-card">
      <text>{{error}}</text>
      <view class="button-row">
        <button class="ghost-button" hover-class="tap-button-hover" bindtap="loadData">重试</button>
      </view>
    </view>
  </view>

  <block wx:else>
    <view class="section" wx:if="{{needsCompetition}}">
      <view class="empty-card">
        <text class="empty-title">先进入赛事</text>
        <text class="empty-copy">选择赛事后，才能查看该赛事内的胜率预测。</text>
        <view class="button-row">
          <button class="primary-button" hover-class="tap-button-hover" bindtap="goCompetitions">去选择赛事</button>
        </view>
      </view>
    </view>

    <block wx:if="{{!needsCompetition}}">
      <view class="section">
        <view class="scope-bar">
          <view class="scope-main">
            <text class="scope-label">当前赛事</text>
            <text class="scope-title">{{selectedScope.competition}}</text>
            <text class="scope-meta">{{selectedScope.region}} · {{selectedScope.seriesName || "系列赛"}} · {{selectedScope.season || "当前赛季"}}</text>
          </view>
          <button class="scope-button" hover-class="tap-button-hover" bindtap="changeCompetition">切换</button>
        </view>
      </view>

      <view class="section">
        <view class="section-head">
          <text class="section-title">选择比赛日</text>
          <text class="section-note">{{days.length}} 天</text>
        </view>
        <scroll-view class="match-strip" scroll-x="true" wx:if="{{days.length}}">
          <view
            class="match-chip {{selectedDay && selectedDay.played_on === item.played_on ? 'is-active' : ''}}"
            wx:for="{{days}}"
            wx:key="played_on"
            data-played-on="{{item.played_on}}"
            hover-class="tap-chip-hover"
            bindtap="chooseDay"
          >
            <text class="match-chip-title">{{item.played_on || "未定日期"}}</text>
            <text class="match-chip-copy">{{item.match_count || 0}} 场 · {{item.player_entry_count || 0}} 人次</text>
          </view>
        </scroll-view>
        <view class="empty-card" wx:else>
          <text class="empty-title">暂无可预测比赛日</text>
          <text class="empty-copy">录入当天赛程和名单后，这里会显示比赛日预测入口。</text>
        </view>
      </view>

      <view class="section" wx:if="{{selectedDay}}">
        <view class="selected-match">
          <text class="selected-label">当前比赛日</text>
          <text class="selected-title">{{selectedDay.label || selectedDay.played_on}}</text>
          <text class="selected-copy">12人随机模拟三局 · {{scenario ? "已发布场景" : (rosterSource === "official_schedule" ? "正式赛程名单" : "暂无完整名单")}}</text>
        </view>
      </view>

      <view class="section" wx:if="{{predictions.length}}">
        <view class="forecast-summary">
          <view class="band-grid">
            <view class="band-stat" wx:for="{{bandSummary}}" wx:key="label">
              <text class="band-value">{{item.value}}</text>
              <text class="band-label">{{item.label}}</text>
              <text class="band-copy">{{item.copy}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="section" wx:if="{{notice}}">
        <view class="notice-card">{{notice}}</view>
      </view>

      <view class="section" wx:if="{{predictions.length}}">
        <view class="section-head">
          <text class="section-title">当日预计总分</text>
          <text class="section-note">{{predictionVisibleCount}} / {{predictionTotalCount}} 人</text>
        </view>
        <view class="stack">
          <view class="prediction-card {{item.bandClass}}" wx:for="{{predictions}}" wx:key="player_id">
            <view class="prediction-head tap-card" hover-class="tap-card-hover" data-player-id="{{item.profilePlayerId}}" bindtap="openPlayer">
              <view class="seat-pill">{{item.rank}}</view>
              <view class="prediction-main">
                <view class="prediction-title-line">
                  <view class="player-name-line">
                    <text class="prediction-name">{{item.player_name}}</text>
                    <star-player-badge wx:if="{{item.is_star_player}}" compact="{{true}}" />
                  </view>
                </view>
                <text class="prediction-meta">{{item.predictionMeta}}</text>
              </view>
              <view class="expected-box">
                <text class="expected-value">{{item.expected_total || item.expected_points}}</text>
                <text class="expected-label">{{item.bandLabel}}</text>
              </view>
              <text class="tap-cue" wx:if="{{item.profilePlayerId}}">›</text>
            </view>

            <view class="game-prob-grid" wx:if="{{item.gameWinDisplays.length}}">
              <view class="game-prob-item" wx:for="{{item.gameWinDisplays}}" wx:for-item="probability" wx:for-index="gameIndex" wx:key="gameIndex">
                <text class="prob-label">第{{gameIndex + 1}}局胜率</text>
                <text class="prob-value">{{probability}}</text>
              </view>
            </view>

            <view class="win-distribution" wx:if="{{item.winCountLabels.length}}">
              <text class="prob-label">胜场分布</text>
              <text class="distribution-copy">{{item.winCountText}}</text>
            </view>

            <view class="market-grid" wx:if="{{item.markets.length}}">
              <view class="market-item" wx:for="{{item.markets}}" wx:for-item="market" wx:key="key">
                <text class="prob-label">{{market.label}}</text>
                <text class="prob-value">{{market.display}}</text>
                <text class="equality-copy">等于 {{market.equalityDisplay}}</text>
              </view>
            </view>

            <view class="day-match-list" wx:if="{{item.matchLabels.length}}">
              <view class="day-match-item" wx:for="{{item.matchLabels}}" wx:for-item="label" wx:key="*this">
                <text>{{label}}</text>
              </view>
            </view>
          </view>
        </view>
        <view class="button-row" wx:if="{{predictionHasMore}}">
          <button class="ghost-button" hover-class="tap-button-hover" loading="{{loadingMore}}" disabled="{{loadingMore}}" bindtap="loadMorePredictions">加载更多</button>
        </view>
        <view class="empty-inline" wx:if="{{loadMoreError}}"><text>{{loadMoreError}}</text></view>
      </view>

      <view class="section" wx:elif="{{selectedDay}}">
        <view class="empty-card">
          <text class="empty-title">暂无预测数据</text>
          <text class="empty-copy">这个比赛日还没有可计算的选手名单。</text>
        </view>
      </view>
    </block>
  </block>
</view>

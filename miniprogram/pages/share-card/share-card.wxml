<view class="page">
  <view class="intro">
    <text class="intro-title">黑金战绩卡</text>
    <text class="intro-copy">扫码可直达该选手的小程序详情页。</text>
  </view>
  <view class="mode-switch">
    <button class="mode-button {{mode === 'vertical' ? 'is-active' : ''}}" data-mode="vertical" bindtap="setMode">竖版</button>
    <button class="mode-button {{mode === 'landscape' ? 'is-active' : ''}}" data-mode="landscape" bindtap="setMode">横版</button>
  </view>
  <view class="achievement-picker" wx:if="{{achievements.length}}">
    <text class="picker-label">选择成就（最多 2 个）</text>
    <view class="achievement-chips">
      <view class="achievement-chip {{item.selected ? 'is-selected' : ''}}" wx:for="{{achievements}}" wx:key="code" data-code="{{item.code}}" bindtap="toggleAchievement">
        <text>{{item.title}}</text><text wx:if="{{item.meta}}"> · {{item.meta}}</text>
      </view>
    </view>
  </view>
  <view
    class="canvas-tap-target"
    hover-class="canvas-tap-hover"
    hover-stay-time="120"
    bindtap="previewCard"
    aria-role="button"
    aria-label="点击战绩卡查看大图"
  >
    <canvas type="2d" id="shareCanvas" class="share-canvas {{mode === 'landscape' ? 'is-landscape' : ''}}"></canvas>
  </view>
  <text class="canvas-tap-hint">点击图片查看大图</text>
  <view class="button-row">
    <button class="primary-button" hover-class="tap-button-hover" loading="{{loading}}" bindtap="saveCard">保存到相册</button>
  </view>
  <view class="empty-inline" wx:if="{{error}}"><text>{{error}}</text></view>
</view>

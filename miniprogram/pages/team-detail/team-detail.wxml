<view class="page">
  <view class="team-hero">
    <image wx:if="{{team.logoUrl}}" class="team-logo" src="{{team.logoUrl}}" mode="aspectFill" binderror="onTeamImageError"></image>
    <view wx:else class="team-logo image-placeholder"></view>
    <view class="team-main">
      <text class="team-eyebrow">{{team.guild || "未加入门派"}}</text>
      <text class="team-name">{{team.short_name || team.name || "战队详情"}}</text>
      <text class="team-copy">{{team.competition || "当前赛事"}} · {{team.season || "当前赛季"}}</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="section">
    <view class="empty-card">
      <text class="empty-title">正在加载</text>
      <text class="empty-copy">正在读取战队详情。</text>
    </view>
  </view>

  <view wx:elif="{{needsCompetition}}" class="section">
    <view class="empty-card">
      <text class="empty-title">先进入赛事</text>
      <text class="empty-copy">选择赛事后，才能查看该赛事范围下的战队详情。</text>
      <view class="button-row">
        <button class="primary-button" hover-class="tap-button-hover" bindtap="goCompetitions">去选择赛事</button>
      </view>
    </view>
  </view>

  <view wx:elif="{{error}}" class="section">
    <view class="error-card">
      <text>{{error}}</text>
      <view class="button-row">
        <button class="ghost-button" hover-class="tap-button-hover" bindtap="loadData">重试</button>
      </view>
    </view>
  </view>

  <block wx:else>
    <view class="section">
      <view class="scope-bar">
        <view class="scope-main">
          <text class="scope-label">当前赛事</text>
          <text class="scope-title">{{selectedScope.competition}}</text>
          <text class="scope-meta">{{selectedScope.region}} · {{selectedScope.seriesName || "系列赛"}} · {{selectedScope.season || "当前赛季"}}</text>
        </view>
        <button class="scope-button" hover-class="tap-button-hover" bindtap="changeCompetition">切换</button>
      </view>
      <view class="quick-actions">
        <button class="ghost-button" hover-class="tap-button-hover" bindtap="openCompare">战队对比</button>
      </view>
    </view>

    <view class="section">
      <view class="metrics">
        <view class="metric-card" wx:for="{{metrics}}" wx:key="label">
          <text class="metric-label">{{item.label}}</text>
          <text class="metric-value">{{item.value}}</text>
          <text class="metric-copy">{{item.copy}}</text>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="insight-card">
        <view class="insight-row">
          <text>赛季战绩</text>
          <text>{{insights.record || "--"}}</text>
        </view>
        <view class="bar"><view class="bar-fill" style="width: {{insights.win_width || 0}}%;"></view></view>
        <view class="insight-row">
          <text>场均积分</text>
          <text>{{insights.points_per_match || "--"}}</text>
        </view>
        <view class="bar"><view class="bar-fill alt" style="width: {{insights.points_width || 0}}%;"></view></view>
        <text class="insight-note">{{insights.stage_summary || "暂无赛段信息"}}</text>
      </view>
    </view>

    <view class="section" wx:if="{{achievements.length}}">
      <view class="section-head">
        <text class="section-title">成就标签</text>
        <text class="section-note">{{achievements.length}} 个</text>
      </view>
      <view class="achievement-grid">
        <view class="achievement-card {{item.className}}" wx:for="{{achievements}}" wx:key="code">
          <view class="achievement-top">
            <text class="achievement-code">{{item.code}}</text>
            <text class="achievement-tier">{{item.tierLabel}}</text>
          </view>
          <text class="achievement-title">{{item.title}}</text>
          <text class="achievement-meta">{{item.meta || item.description}}</text>
        </view>
      </view>
    </view>

    <view class="section" wx:if="{{roster.length}}">
      <view class="section-head">
        <text class="section-title">当前阵容</text>
        <text class="section-note">{{roster.length}} 人</text>
      </view>
      <view class="stack">
        <view class="list-card tap-card" hover-class="tap-card-hover" wx:for="{{roster}}" wx:key="player_id" data-player-id="{{item.player_id}}" bindtap="openPlayer">
          <image wx:if="{{item.photoUrl}}" class="avatar" src="{{item.photoUrl}}" mode="aspectFill" lazy-load="{{true}}" aria-label="{{item.display_name}}头像" data-index="{{index}}" binderror="onPlayerImageError"></image>
          <view wx:else class="avatar image-placeholder"></view>
          <view class="list-main">
            <text class="list-title">{{item.name}}</text>
            <text class="list-meta">{{item.matches}} 局 · 胜率 {{item.win_rate}} · 常用 {{item.top_role}}</text>
          </view>
          <view class="list-score">
            <text class="score-value">{{item.points}}</text>
            <text class="score-label">积分</text>
          </view>
          <text class="tap-cue">›</text>
        </view>
      </view>
    </view>

    <view class="section" wx:if="{{matches.length}}">
      <view class="section-head">
        <text class="section-title">最近比赛</text>
      </view>
      <view class="stack">
        <view class="list-card match-card {{item.resultClass}}" wx:for="{{matches}}" wx:key="match_id">
          <view class="list-main">
            <text class="list-title">{{item.played_on}} · 第{{item.round}}轮第{{item.game_no}}局</text>
            <text class="list-meta">{{item.stage_label}} · {{item.result}} · {{item.identitySummaryText}}</text>
          </view>
          <view class="list-score">
            <text class="score-value">{{item.points}}</text>
            <text class="score-label">战队分</text>
          </view>
        </view>
      </view>
    </view>
  </block>
</view>

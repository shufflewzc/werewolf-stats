.team-hero {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx;
  border-radius: 16rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #111827 0%, #1e3a5f 62%, #be7c25 100%);
}

.team-logo {
  flex: 0 0 128rpx;
  width: 128rpx;
  height: 128rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.35);
  border-radius: 18rpx;
  background: #e2e8f0;
}

.team-main {
  flex: 1;
  min-width: 0;
}

.team-eyebrow,
.team-copy {
  display: block;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.74);
}

.team-name {
  display: block;
  margin-top: 8rpx;
  overflow: hidden;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.team-copy {
  margin-top: 10rpx;
}

.insight-card {
  padding: 24rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.06);
}

.insight-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 18rpx;
  font-size: 24rpx;
  color: #334155;
}

.insight-row:first-child {
  margin-top: 0;
}

.bar {
  height: 14rpx;
  margin-top: 12rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e2e8f0;
}

.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #111827;
}

.bar-fill.alt {
  background: #0f766e;
}

.insight-note {
  display: block;
  margin-top: 18rpx;
  font-size: 22rpx;
  color: #64748b;
}

.match-card {
  position: relative;
  overflow: hidden;
}

.match-card::before {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 8rpx;
  content: "";
  background: #94a3b8;
}

.match-card.is-win {
  border-color: #bbf7d0;
  background: #f0fdf4;
}

.match-card.is-win::before,
.match-card.is-win .score-value {
  color: #15803d;
  background: #16a34a;
}

.match-card.is-win .score-value {
  background: transparent;
}

.match-card.is-loss {
  border-color: #fecaca;
  background: #fff7f7;
}

.match-card.is-loss::before,
.match-card.is-loss .score-value {
  color: #b91c1c;
  background: #dc2626;
}

.match-card.is-loss .score-value {
  background: transparent;
}

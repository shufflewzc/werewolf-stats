<view class="page">
  <view class="hero">
    <text class="eyebrow">Teams</text>
    <text class="title">门派排行榜</text>
    <text class="copy">{{scope.description || "查看门派积分、胜率和出赛表现。"}}</text>
  </view>

  <view wx:if="{{loading}}" class="section">
    <view class="empty-card">
      <text class="empty-title">正在加载</text>
      <text class="empty-copy">正在读取门派排行。</text>
    </view>
  </view>

  <view wx:elif="{{error}}" class="section">
    <view class="error-card">
      <text>{{error}}</text>
      <view class="button-row">
        <button class="ghost-button" hover-class="tap-button-hover" bindtap="loadData">重试</button>
      </view>
    </view>
  </view>

  <block wx:else>
    <view class="section" wx:if="{{needsCompetition}}">
      <view class="empty-card">
        <text class="empty-title">先进入赛事</text>
        <text class="empty-copy">选择赛事后，才能查看该赛事内的门派数据。</text>
        <view class="button-row">
          <button class="primary-button" hover-class="tap-button-hover" bindtap="goCompetitions">去选择赛事</button>
        </view>
      </view>
    </view>

    <block wx:if="{{!needsCompetition}}">
    <view class="section">
      <view class="metrics">
        <view class="metric-card" wx:for="{{metrics}}" wx:key="label">
          <text class="metric-label">{{item.label}}</text>
          <text class="metric-value">{{item.value}}</text>
          <text class="metric-copy">{{item.copy}}</text>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-head">
        <text class="section-title">{{scope.label || "当前范围"}}</text>
        <text class="section-note">{{teams.length}} 支</text>
      </view>
      <view class="stack" wx:if="{{teams.length}}">
        <view class="list-card team-row" wx:for="{{teams}}" wx:key="team_id">
          <text class="rank">{{item.rank}}</text>
          <image wx:if="{{item.logoUrl}}" class="logo" src="{{item.logoUrl}}" mode="aspectFill" data-index="{{index}}" binderror="onTeamImageError"></image>
          <view wx:else class="logo image-placeholder"></view>
          <view class="list-main">
            <text class="list-title">{{item.short_name || item.name}}</text>
            <text class="list-meta">胜率 {{item.win_rate}} · {{item.wins}}胜{{item.losses}}负 · {{item.player_count}} 人</text>
          </view>
          <view class="list-score">
            <text class="score-value">{{item.points_total}}</text>
            <text class="score-label">积分</text>
          </view>
        </view>
      </view>
      <view class="empty-card" wx:else>
        <text class="empty-title">暂无门派</text>
        <text class="empty-copy">录入比赛结果后，这里会显示门派排行。</text>
      </view>
    </view>
    </block>
  </block>
</view>
